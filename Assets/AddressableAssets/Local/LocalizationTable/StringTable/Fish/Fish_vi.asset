  m_TableData:
  - m_Id: 288206175068160
    m_Localized: "B\u1ED9 s\u01B0u t\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759936
    m_Localized: "B\u1EAFt \u0111\u1EA7u c\xE2u c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759937
    m_Localized: "N\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759938
    m_Localized: "M\u1ED3i c\xE2u"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759939
    m_Localized: "Gi\u1EDBi thi\u1EC7u minigame c\xE2u c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759940
    m_Localized: "C\u1EA5p \u0111\u1ED9 c\xE2u c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759941
    m_Localized: "K\u1EF7 l\u1EE5c c\xE2u c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759942
    m_Localized: "Gi\u1EEF chu\u1ED9t tr\xE1i \u0111\u1EC3 \u0111i\u1EC1u khi\u1EC3n
      l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759943
    m_Localized: "Thu c\u1EA7n (Chu\u1ED9t ph\u1EA3i)"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759944
    m_Localized: "C\xE1 \u0111\xE3 ch\u1EA1y m\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759945
    m_Localized: "C\xE1 c\u1EAFn c\xE2u r\u1ED3i!!"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759946
    m_Localized: "\u0110ang ch\u1EDD c\xE1 c\u1EAFn c\xE2u..."
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759947
    m_Localized: "C\u1EADu kh\xE1 \u0111\u1EA5y ch\u1EE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759948
    m_Localized: "L\u1EA7n sau c\u1ED1 g\u1EAFng h\u01A1n nh\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759949
    m_Localized: "L\xE0m t\u1ED1t l\u1EAFm~"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759950
    m_Localized: "Ti\u1EBFp t\u1EE5c c\xE2u c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 288206254759951
    m_Localized: "Kh\xF4ng \u0111\u1EE7 m\u1ED3i c\xE2u"
    m_Metadata:
      m_Items: []
  references:
