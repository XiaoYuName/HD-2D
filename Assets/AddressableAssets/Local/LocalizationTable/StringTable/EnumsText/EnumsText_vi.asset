    m_Metadata:
      m_Items: []
  - m_Id: 3333080773529600
    m_Localized: "C\u1EEDa h\xE0ng rau qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 3333138369712128
    m_Localized: "C\u1EEDa h\xE0ng v\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 3333173639614464
    m_Localized: "C\u1EEDa h\xE0ng \u0111\u1ED3 ng\u01B0\u1EDDi l\u1EDBn"
