  m_TableData:
  - m_Id: 7868747776
    m_Localized: "Ch\u1EC9 l\xE0 v\u1EBD cosplay nh\xE2n v\u1EADt m\xECnh th\xEDch
      nh\u1EA5t \u0111\u1EC3 t\u1EF1 ch\u1EEFa l\xE0nh th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 79910113280
    m_Localized: "R\u1EA3nh qu\xE1 n\xEAn m\xECnh v\u1EBD v\xE0i minh h\u1ECDa cosplay.
      M\u1ECDi ng\u01B0\u1EDDi th\xEDch ki\u1EC3u t\u1EA1o h\xECnh cosplay n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 131567161344
    m_Localized: "V\u1EEBa v\u1EBD v\u1EEBa ngh\u0129 \xFD t\u01B0\u1EDFng cos m\u1EDBi
      cho OC, h\xF3ng c\u1EA3m ngh\u0129 c\u1EE7a m\u1ECDi ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 253705293824
    m_Localized: "Th\u1EA5y m\xE0n cosplay si\xEAu \u0111\u1EB9p c\u1EE7a coser \u0111\xF3
      n\xEAn kh\xF4ng nh\u1ECBn \u0111\u01B0\u1EE3c m\xE0 b\u1EAFt tay v\xE0o v\u1EBD."
    m_Metadata:
      m_Items: []
  references:
    version: 2
