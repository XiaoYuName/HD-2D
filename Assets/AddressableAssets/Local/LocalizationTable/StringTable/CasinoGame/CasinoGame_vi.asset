  m_TableData:
  - m_Id: 60396969910272
    m_Localized: "Thu\u1ED1c \u0110\u1ED9c Ph\xF9 Th\u1EE7y"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881792
    m_Localized: "V\xE0ng hi\u1EC7n c\xF3: {GameCoin}"
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881793
    m_Localized: "Ti\u1EC1n c\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881794
    m_Localized: "S\u1ED1 h\u1ED9p"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881795
    m_Localized: "H\u1EC7 s\u1ED1"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881796
    m_Localized: "Ti\u1EC1n th\u1EAFng"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881797
    m_Localized: '{Bet}'
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881798
    m_Localized: '{Payout}'
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881799
    m_Localized: '{Opened}/{Total}'
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881800
    m_Localized: '{Multiplier}x'
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881801
    m_Localized: "T\u1ED1i thi\u1EC3u {MinBet}  T\u1ED1i \u0111a {MaxBet}"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881802
    m_Localized: "B\u1EAFt \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881803
    m_Localized: "R\xFAt lui"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881804
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881805
    m_Localized: "Ph\xFAc l\xE0nh ph\xF9 th\u1EE7y! H\u1EC7 s\u1ED1 nh\xE2n \u0111\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881807
    m_Localized: "R\xFAt lui th\xE0nh c\xF4ng! Nh\u1EADn {Payout} v\xE0ng"
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881808
    m_Localized: "Tr\xFAng thu\u1ED1c \u0111\u1ED9c! M\u1EA5t h\u1EBFt ti\u1EC1n
      th\u1EAFng"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881809
    m_Localized: "H\u01B0\u1EDBng d\u1EABn"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881810
    m_Localized: "K\u1EBFt Qu\u1EA3 V\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881811
    m_Localized: "V\u1EADt ph\u1EA9m \u0111\xE3 \u0111\u01B0\u1EE3c t\u1EF1 \u0111\u1ED9ng
      th\xEAm v\xE0o t\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881812
    m_Localized: "Ch\u01A1i L\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881813
    m_Localized: "-{Sp} Th\u1EC3 l\u1EF1c"
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881814
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881815
    m_Localized: "May m\u1EAFn th\u1EADt~"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881816
    m_Localized: "Ch\xFAc may m\u1EAFn l\u1EA7n sau!"
    m_Metadata:
      m_Items: []
  - m_Id: 60396990881817
    m_Localized: "Ti\u1EC1n c\u01B0\u1EE3c: <color=#E8C84A>-{Bet}</color>\r\nL\u1ECD
      an to\xE0n: {Opened}\r\nH\u1EC7 s\u1ED1: <color=#FF5C8A>{Multiplier}x</color>\r\n\r\n<color=#B66BFF><size=120%>V\xE0ng
      nh\u1EADn \u0111\u01B0\u1EE3c: +{Payout}</size></color>"
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881818
    m_Localized: "Ti\u1EC1n c\u01B0\u1EE3c: <color=#E8C84A>-{Bet}</color>\r\nL\u1ECD
      an to\xE0n: {Opened}\r\n<color=#FF5C8A>V\xE0ng m\u1EA5t: -{Bet}</color>"
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 60396990881819
    m_Localized: "Kh\xF4ng \u0111\u1EE7 th\u1EC3 l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 669840380518400
    m_Localized: "Ti\u1EC1n c\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072832
    m_Localized: "D\u1EF1 ki\u1EBFn nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072833
    m_Localized: "H\u1EC7 s\u1ED1 t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072834
    m_Localized: "Th\u1EA5p nh\u1EA5t {MinBet} Cao nh\u1EA5t {MaxBet}"
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 669840414072835
    m_Localized: "B\u1EAFt \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072836
    m_Localized: "D\u1EEBng l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072837
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072838
    m_Localized: "Kh\xF4ng \u0111\u1EE7 xu"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072839
    m_Localized: "May m\u1EAFn th\u1EADt~"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072840
    m_Localized: "Tham qu\xE1 r\u1ED3i~"
    m_Metadata:
      m_Items: []
  - m_Id: 669840414072841
    m_Localized: "Ti\u1EC1n c\u01B0\u1EE3c: <color=#E8C84A>-{Bet}</color>\nH\u1EC7
      s\u1ED1 ch\u1ED1t: <color=#FF5C8A>{Multiplier}x</color>\n\u0110i\u1EC3m n\u1ED5:
      <color=#FF5C8A>{Crash}x</color>\n\n<color=#B66BFF><size=120%>Xu nh\u1EADn \u0111\u01B0\u1EE3c:
      +{Payout}</size></color>"
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 669840414072842
    m_Localized: "Ti\u1EC1n c\u01B0\u1EE3c: <color=#E8C84A>-{Bet}</color>\n\u0110i\u1EC3m
      n\u1ED5: <color=#FF5C8A>{Crash}x</color>\n<color=#FF5C8A>Xu m\u1EA5t: -{Bet}</color>"
    m_Metadata:
      m_Items:
      - rid: 702015434171351132
  - m_Id: 2467799996817408
    m_Localized: "M\xE1y G\u1EAFp Th\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 2467799996817409
    m_Localized: "Th\u1EA3 xu, \u0111i\u1EC1u khi\u1EC3n c\xE0ng g\u1EAFp v\xE0 gi\xE0nh
      l\u1EA5y ph\u1EA7n th\u01B0\u1EDFng b\u1EA1n th\xEDch!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467799996817410
    m_Localized: "B\u1EE9t T\u1ED1c \u0110i\u1EC3m N\u1ED5"
    m_Metadata:
      m_Items: []
  - m_Id: 2467799996817411
    m_Localized: "H\u1EC7 s\u1ED1 t\u0103ng li\xEAn t\u1EE5c\u2014d\u1EEBng l\u1EA1i
      tr\u01B0\u1EDBc \u0111i\u1EC3m n\u1ED5 \u0111\u1EC3 gi\xE0nh th\u01B0\u1EDFng
      l\u1EDBn!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467799996817412
    m_Localized: "Thu\u1ED1c \u0110\u1ED9c Ph\xF9 Th\u1EE7y"
    m_Metadata:
      m_Items: []
  - m_Id: 2467799996817413
    m_Localized: "M\u1EDF t\u1EEBng l\u1ECD thu\u1ED1c \u0111\u1EC3 t\xEDch h\u1EC7
      s\u1ED1\u2014tr\xE1nh thu\u1ED1c \u0111\u1ED9c v\xE0 r\xFAt lui \u0111\xFAng
      l\xFAc!"
    m_Metadata:
      m_Items: []
