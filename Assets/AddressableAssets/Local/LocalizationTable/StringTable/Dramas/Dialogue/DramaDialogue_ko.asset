  m_TableData:
  - m_Id: 10298552320
    m_Localized: "\uC624\uB298\uC758 \uC0C1\uD0DC: \uBC30\uD130\uB9AC 0%, \uC815\uC2E0\uB825
      \uC644\uC804\uD788 \uBC14\uB2E5\uB0A8."
    m_Metadata:
      m_Items: []
  - m_Id: 58721792000
    m_Localized: "\uC0AC\uB78C\uC774 \uC5B4\uB5BB\uAC8C \uC548 \uD37C\uC9C8 \uC218\uAC00
      \uC788\uACA0\uC5B4. \uB2E4\uB4E4 \uC560\uB2C8\uB791 \uCD5C\uC560 \uC640\uC774\uD504
      \uB355\uBD84\uC5D0 \uACA8\uC6B0 \uBC84\uD2F0\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 3629179241467904
    m_Localized: "\uD604\uC2E4\uC740 \uC815\uB9D0 \uB108\uBB34 \uD798\uB4E4\uACE0,
      \uC624\uC9C1 \uC774\uCC28\uC6D0\uB9CC\uC774 \uB098\uC5D0\uAC8C \uAD6C\uC6D0\uC744
      \uC904 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828032
    m_Localized: "\uC2E0\uC791 \uC560\uB2C8 \uC2DC\uC791\uD569\uB2C8\uB2E4. \uD604\uC2E4\uC740
      \uC7A0\uC2DC \uC624\uD504\uB77C\uC778, \uBC29\uD574 \uAE08\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828033
    m_Localized: "\uB54C\uB824 \uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828034
    m_Localized: "\uC9C4\uC2EC\uC774\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828035
    m_Localized: "\uB098 \uB54C\uB9AC\uB294 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828036
    m_Localized: "\uB0B4 \uBC1C\uCC28\uAE30\uB97C \uBC1B\uC544\uB77C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828037
    m_Localized: "\uBCF4\uD638 \uD5E4\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828038
    m_Localized: "\uC544, \uB0B4 \uBC30\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828039
    m_Localized: "\uBC30\uB97C \uBCF4\uD638\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828040
    m_Localized: "\uB0B4 \uACE0\uCD94\uAC00!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828041
    m_Localized: "\uB529\uB529\uC744 \uBCF4\uD638\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828042
    m_Localized: "\uC544, \uB0B4 \uBA38\uB9AC\uC57C."
    m_Metadata:
      m_Items: []
