  m_TableData:
  - m_Id: 10298552320
    m_Localized: 'Today''s status: battery at 0%, mental energy completely depleted.'
    m_Metadata:
      m_Items: []
  - m_Id: 58721792000
    m_Localized: "Who isn\u2019t completely wiped out? We\u2019re all just hanging
      in there thanks to anime and our waifus."
    m_Metadata:
      m_Items: []
  - m_Id: 3629179241467904
    m_Localized: Reality is tough as hell; only the 2D world can give me salvation.
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828032
    m_Localized: "Starting a new anime\u2014reality is temporarily offline. Do not
      disturb."
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828033
    m_Localized: Go ahead, hit me!
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828034
    m_Localized: Are you serious?
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828035
    m_Localized: You're hitting me!
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828036
    m_Localized: Take this kick!
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828037
    m_Localized: Protective head
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828038
    m_Localized: Oh, my stomach!
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828039
    m_Localized: Protect your belly
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828040
    m_Localized: My willy!
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828041
    m_Localized: Protect Ding Ding
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828042
    m_Localized: Oh, my head.
    m_Metadata:
      m_Items: []
