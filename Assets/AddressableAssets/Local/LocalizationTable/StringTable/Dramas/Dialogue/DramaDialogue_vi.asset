  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DramaDialogue_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 5c260af845f11b84a813c528d7f26231, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10298552320
    m_Localized: "T\xECnh tr\u1EA1ng h\xF4m nay: pin 0%, tinh th\u1EA7n c\u1EA1n
      ki\u1EC7t ho\xE0n to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 58721792000
    m_Localized: "L\xE0m g\xEC c\xF3 ai m\xE0 kh\xF4ng g\u1EE5c ch\u1EE9. Ch\u1EB3ng
      qua l\xE0 \u0111ang g\u1EAFng g\u01B0\u1EE3ng nh\u1EDD anime v\xE0 waifu th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 3629179241467904
    m_Localized: "Hi\u1EC7n th\u1EF1c kh\u1ED5 s\u1EDF v\xF4 c\xF9ng, ch\u1EC9 c\xF3
      th\u1EBF gi\u1EDBi 2D m\u1EDBi c\xF3 th\u1EC3 c\u1EE9u r\u1ED7i t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828032
    m_Localized: "B\u1EAFt \u0111\u1EA7u xem anime m\u1EDBi, th\u1EF1c t\u1EA1i t\u1EA1m
      th\u1EDDi ngo\u1EA1i tuy\u1EBFn, \u0111\u1EEBng l\xE0m phi\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828033
    m_Localized: "C\u1EE9 \u0111\xE1nh t\xF4i \u0111i!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828034
    m_Localized: "Nghi\xEAm t\xFAc \u0111\u1EA5y \xE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828035
    m_Localized: "B\u1EA1n \u0111\xE1nh t\xF4i \xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828036
    m_Localized: "\u0102n m\u1ED9t c\xFA \u0111\xE1 c\u1EE7a ta \u0111\xE2y!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828037
    m_Localized: "\u0110\u1EA7u b\u1EA3o v\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828038
    m_Localized: "\xD4i, b\u1EE5ng t\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828039
    m_Localized: "B\u1EA3o v\u1EC7 b\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828040
    m_Localized: "C\u1EADu nh\u1ECF c\u1EE7a t\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828041
    m_Localized: "B\u1EA3o v\u1EC7 \u0110inh \u0110inh"
    m_Metadata:
      m_Items: []
  - m_Id: 3629179270828042
    m_Localized: "\xD4i, \u0111\u1EA7u t\xF4i."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
