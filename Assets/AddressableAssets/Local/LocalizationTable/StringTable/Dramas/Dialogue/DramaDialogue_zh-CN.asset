  - m_Id: 21443407474962437
    m_Localized: "\uFF08\u7A81\u7136\u6709\u79CD\u4E0D\u597D\u7684\u9884\u611F\u662F\u600E\u4E48\u56DE\u4E8B\u2026\u2026\uFF09"
    m_Metadata:
      m_Items: []
  - m_Id: 21443407474962438
    m_Localized: "\u8BF7\u8BB2\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 21443407474962439
    m_Localized: "\u65E0\u8BBA\u662F\u600E\u6837\u7684\u5FC3\u613F\uFF0C\u8BF7\u5BF9\u6211\u8BF4\u51FA\u6765\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 21443407474962440
    m_Localized: "\u8BF6\u5440\uFF0C\u4E0D\u6127\u662F\u6781\u9053\u7684\u82E5\u5934\u5462\uFF0C\u8FD9\u80A1\u89C6\u6B7B\u5982\u5F52\u7684\u52BF\u5934\u5F88\u4E0D\u9519\u5462\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 21443407474962441
    m_Localized: "\u96BE\u529E\uFF0C\u90A3\u5C31\u522B\u529E\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 21443407474962442
    m_Localized: "\u5982\u679C\u662F\u592A\u4E3A\u96BE\u7684\u613F\u671B\uFF0C\u90A3\u8FD8\u662F\u4E0D\u5F00\u53E3\u7684\u4E3A\u597D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 21443407474962443
    m_Localized: "\u7A0D\u5FAE\u9047\u5230\u70B9\u56F0\u96BE\u5C31\u9000\u7F29\u4E86\u5417\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 21443407474962444
    m_Localized: "\u770B\u6765\u59D0\u59D0\u7684\u6B7B\u5728{global.PlayerName}\u541B\u5FC3\u91CC\u4E5F\u4E0D\u8FC7\u662F\u65E0\u5173\u7D27\u8981\u7684\u5C0F\u4E8B\u5462\u3002"
    m_Metadata:
