  m_Name: MachiRoom_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: b99e6d7f3066c4a4daf830ab29d85e89, type: 2}
  m_Metadata:
    m_Items:
    - rid: 3750916117354250573
  m_TableData:
  - m_Id: 14512153162670080
    m_Localized: "C\u1EA3m h\u1EE9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 14512153166864384
    m_Localized: "\xC1p l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 14857823753068544
    m_Localized: "V\u1EBD b\u1EA3n ph\xE1c th\u1EA3o b\u1EB1ng c\u1ECD"
    m_Metadata:
      m_Items: []
  - m_Id: 14857823774040064
    m_Localized: "B\u1ECF qua t\xE1c ph\u1EA9m"
    m_Metadata:
      m_Items: []
  - m_Id: 14857823778234368
    m_Localized: "Suy ngh\u0129 l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 14857823778234369
    m_Localized: "V\u1EBD b\u1EE9c n\xE0y!"
    m_Metadata:
      m_Items: []
  - m_Id: 14857823778234370
    m_Localized: "B\xF9ng n\u1ED5 c\u1EA3m h\u1EE9ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 14857823778234371
    m_Localized: "Ti\u1EBFn \u0111\u1ED9 b\u1EA3n v\u1EBD"
    m_Metadata:
      m_Items: []
  - m_Id: 14857823778234372
    m_Localized: "Th\xFAc gi\u1EE5c ho\xE0n th\xE0nh b\u1EA3n v\u1EBD"
    m_Metadata:
      m_Items: []
  - m_Id: 14857823778234373
    m_Localized: "\u0110i\u1EC3m: {Score}"
    m_Metadata:
      m_Items:
      - rid: 3750916117354250573
  - m_Id: 14857823778234374
    m_Localized: "Ti\xEAu hao {Count} \u0111i\u1EC3m h\xE0nh \u0111\u1ED9ng"
    m_Metadata:
      m_Items:
      - rid: 3750916117354250573
  - m_Id: 14857823778234375
    m_Localized: "\u201CMachi kh\xF4ng \u1EDF trong studio, vi\u1EC7c s\xE1ng t\xE1c
      \u0111\xE3 t\u1EA1m d\u1EEBng\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 14788632790425600
    m_Localized: "Kh\xF4ng \u0111\u1EE7 c\u1EA3m h\u1EE9ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 14788632815591424
    m_Localized: "V\u1EA3i v\u1EBD m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 14788632815591425
    m_Localized: "Machi hi\u1EC7n \u0111ang trong t\xECnh tr\u1EA1ng r\u1EA5t t\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 14788632815591426
    m_Localized: "H\xF4m nay v\u1EBD g\xEC \u0111\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 14788632815591427
    m_Localized: "L\u01B0\u1EDDi bi\u1EBFng.psd"
    m_Metadata:
      m_Items: []
  - m_Id: 14788632815591428
    m_Localized: "V\u1EBD nghi\xEAm t\xFAc.psd"
    m_Metadata:
      m_Items: []
  - m_Id: 14788632815591429
    m_Localized: "Ki\u1EC7t t\xE1c.psd"
    m_Metadata:
      m_Items: []
  - m_Id: 14788632815591430
    m_Localized: "Ti\xEAu hao {Count} c\u1EA3m h\u1EE9ng"
    m_Metadata:
      m_Items:
      - rid: 3750916117354250573
  - m_Id: 15215678494597120
    m_Localized: "Ch\u1EA5t l\u01B0\u1EE3ng t\xE1c ph\u1EA9m k\xE9m, kh\xF4ng nh\u1EADn
      \u0111\u01B0\u1EE3c ph\u1EA7n th\u01B0\u1EDFng."
    m_Metadata:
      m_Items: []
  - m_Id: 15246034476195840
    m_Localized: "B\u1EA3n th\u1EA3o \u0111\u1EB7c bi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 15246034505555968
    m_Localized: "N\u1EEF ch\xEDnh \u0111ang s\xE1ng t\xE1c b\u1EA3n th\u1EA3o \u0111\u1EB7c
      bi\u1EC7t~"
    m_Metadata:
      m_Items: []
  - m_Id: 15246034505555969
    m_Localized: "(\u0110\xE3 ho\xE0n th\xE0nh)"
    m_Metadata:
      m_Items: []
  - m_Id: 15246034505555970
    m_Localized: "Ho\xE0n th\xE0nh tranh v\u1EBD"
    m_Metadata:
      m_Items: []
  - m_Id: 15246034505555971
    m_Localized: "Ho\xE0n t\u1EA5t b\u1EA3n v\u1EBD"
    m_Metadata:
      m_Items: []
  - m_Id: 15265255448895488
    m_Localized: "Kh\xF4ng \u0111\u1EE7 \u0111i\u1EC3m h\xE0nh \u0111\u1ED9ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 16235879260479488
    m_Localized: "Ch\u1EA5t l\u01B0\u1EE3ng t\xE1c ph\u1EA9m qu\xE1 k\xE9m, n\xEAn
      \u0111\xE3 tr\u1EDF th\xE0nh b\u1EA3n th\u1EA3o b\u1ECF \u0111i..."
    m_Metadata:
      m_Items: []
  - m_Id: 16235879285645312
    m_Localized: "B\u1EA3n th\u1EA3o \u0111\xE3 \u0111\u01B0\u1EE3c \u0111\u01B0a
      v\xE0o th\u01B0 vi\u1EC7n b\u1EA3n v\u1EBD"
    m_Metadata:
      m_Items: []
  - m_Id: 16235879285645313
    m_Localized: "Quay l\u1EA1i ti\xEAu \u0111\u1EC1"
    m_Metadata:
      m_Items: []
