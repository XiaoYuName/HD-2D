  m_TableData:
  - m_Id: 43070513995786
    m_Localized: "Gi\xFAp Vi\u1EC7c C\u1EEDa H\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995787
    m_Localized: "Gi\xFAp vi\u1EC7c v\u1EB7t trong c\u1EEDa h\xE0ng \u0111\u1EC3
      nh\u1EADn th\u01B0\u1EDFng!"
    m_Metadata:
      m_Items: []
  - m_Id: 43070493024256
    m_Localized: "B\u1EAFt \u0111\u1EA7u tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995776
    m_Localized: "{SpConsumeCount:cond:>0?Ti\xEAu hao th\u1EC3 l\u1EF1c {} |}{CoinCosumeCount:cond:>0?Xu
      {}|}{ApConsumeCount:cond:>0?Ti\xEAu hao h\xE0nh \u0111\u1ED9ng {}|}"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995777
    m_Localized: "M\xE1y G\u1EAFp Th\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995778
    m_Localized: "Th\u1EA3 xu, \u0111i\u1EC1u khi\u1EC3n c\xE0ng g\u1EAFp v\xE0 gi\xE0nh
      l\u1EA5y ph\u1EA7n th\u01B0\u1EDFng b\u1EA1n th\xEDch!"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995779
    m_Localized: "B\u1EE9t T\u1ED1c \u0110i\u1EC3m N\u1ED5"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995780
    m_Localized: "H\u1EC7 s\u1ED1 t\u0103ng li\xEAn t\u1EE5c\u2014d\u1EEBng l\u1EA1i
      tr\u01B0\u1EDBc \u0111i\u1EC3m n\u1ED5 \u0111\u1EC3 gi\xE0nh th\u01B0\u1EDFng
      l\u1EDBn!"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995781
    m_Localized: "Thu\u1ED1c \u0110\u1ED9c Ph\xF9 Th\u1EE7y"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995782
    m_Localized: "M\u1EDF t\u1EEBng l\u1ECD thu\u1ED1c \u0111\u1EC3 t\xEDch h\u1EC7
      s\u1ED1\u2014tr\xE1nh thu\u1ED1c \u0111\u1ED9c v\xE0 r\xFAt lui \u0111\xFAng
      l\xFAc!"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995783
    m_Localized: "Thi\u1EBFu th\u1EC3 l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995784
    m_Localized: "Kh\xF4ng \u0111\u1EE7 xu"
    m_Metadata:
      m_Items: []
  - m_Id: 43070513995785
    m_Localized: "Thi\u1EBFu h\xE0nh \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  references:
