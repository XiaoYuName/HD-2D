    - rid: 702015583954927785
  m_TableData:
  - m_Id: 5061406809382912
    m_Localized: "Ch\u1EBF t\u1EA1o {ItemName} th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 702015583954927785
  - m_Id: 40838881280
    m_Localized: "N\u1EA5u \u0103n (m\u1EDF kh\xF3a c\xF4ng th\u1EE9c m\u1EDBi)"
    m_Metadata:
      m_Items: []
  - m_Id: 159516712960
    m_Localized: "\u0102n (ti\xEAu hao {ApConsumeCount} h\xE0nh \u0111\u1ED9ng)"
    m_Metadata:
      m_Items: []
  - m_Id: 1022175993856
    m_Localized: "nh\xE0 kho"
    m_Metadata:
      m_Items: []
  - m_Id: 1317211725824
    m_Localized: "Ch\u1EBF t\u1EA1o ti\xEAu hao {SpConsumeCount} th\u1EC3 l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 255686775660544
    m_Localized: "Nh\u1EA5n ph\xEDm c\xE1ch \u0111\u1EC3 x\xE0o n\u1EA5u"
    m_Metadata:
      m_Items: []
  - m_Id: 256847167610880
    m_Localized: "\u0110\u1EBFm ng\u01B0\u1EE3c: {CountDownTime}"
    m_Metadata:
      m_Items:
      - rid: 702015583954927785
  - m_Id: 264511461253120
    m_Localized: "\u0110i \u0111\u1EBFn c\u1EEDa h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 264652272427008
    m_Localized: "Hi\u1EC7n kh\xF4ng c\xF3 nguy\xEAn li\u1EC7u, b\u1EA1n c\xF3 th\u1EC3
      \u0111\u1EBFn c\u1EEDa h\xE0ng ho\u1EB7c c\u1EEDa h\xE0ng rau c\u1EE7 t\u01B0\u01A1i
      \u0111\u1EC3 xem nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 279791935676416
    m_Localized: "B\u1ECF qua"
    m_Metadata:
      m_Items: []
  - m_Id: 5035867881070592
    m_Localized: "\u0110\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 5060868994752512
    m_Localized: "Ch\u1EBF t\u1EA1o th\u1EA5t b\u1EA1i, l\u1EA1i t\u1EA1o ra m\u1ED9t
      \u201CPin Hao Fan\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 1
    m_Localized: "M\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Nh\u1EA5p v\xE0o b\u1EA5t k\u1EF3 \u0111\xE2u tr\xEAn m\xE0n h\xECnh
      \u0111\u1EC3 \u0111\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 13383158744473600
    m_Localized: "Kh\xF4ng \u0111\u1EE7 nguy\xEAn li\u1EC7u, c\u1EA7n \xEDt nh\u1EA5t
      2 lo\u1EA1i nguy\xEAn li\u1EC7u"
    m_Metadata:
      m_Items: []
