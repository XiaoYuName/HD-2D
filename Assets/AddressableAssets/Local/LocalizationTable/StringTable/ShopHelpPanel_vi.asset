  m_TableData:
  - m_Id: 52380153405440
    m_Localized: "Tr\xF2 Ch\u01A1i Nh\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 52380207931392
    m_Localized: "K\u1EBFt Th\xFAc"
    m_Metadata:
      m_Items: []
  - m_Id: 52380207931393
    m_Localized: "H\u01B0\u1EDBng d\u1EABn tr\xF2 ch\u01A1i, h\u01B0\u1EDBng d\u1EABn
      tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 52380207931394
    m_Localized: "Kh\xE1 l\u1EAFm nh\xF3c!"
    m_Metadata:
      m_Items: []
  - m_Id: 52380207931395
    m_Localized: "Kh\xF4ng \u0111\u1EE7 \u0111i\u1EC3m h\xE0nh \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 52380207931396
    m_Localized: "K\u1EBFt Qu\u1EA3 V\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 52380207931397
    m_Localized: "X\u1EBFp xong h\u1EBFt r\u1ED3i, gi\u1ECFi l\u1EAFm!"
    m_Metadata:
      m_Items: []
  - m_Id: 52380207931398
    m_Localized: "H\u1EBFt gi\u1EDD r\u1ED3i, l\u1EA7n sau c\u1ED1 l\xEAn!"
    m_Metadata:
      m_Items: []
  - m_Id: 52380207931399
    m_Localized: "Xu {Coin} | Thi\u1EC7n c\u1EA3m {Favor}"
    m_Metadata:
      m_Items:
      - rid: 3750916043934531698
  - m_Id: 52380212125696
    m_Localized: "Ti\u1EBFc qu\xE1, ch\u01B0a x\u1EBFp h\u1EBFt h\xE0ng k\u1ECBp
      gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 52380212125697
    m_Localized: "Ch\u01A1i L\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 52380212125698
    m_Localized: "Quay L\u1EA1i"
    m_Metadata:
      m_Items: []
