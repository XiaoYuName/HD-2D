      m_Items: []
  - m_Id: 4344844532047874
    m_Localized: "\uAE08\uD615 \uC628\uB3C4\uC81C\uC5B4 \uC2DC\uC2A4\uD15C"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047875
    m_Localized: "AI \uD328\uB4DC \uC778\uC1C4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047876
    m_Localized: "\uC9C4\uACF5 \uACBD\uD654 \uB77C\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047877
    m_Localized: "\uC815\uBC00 \uC131\uD615\uC73C\uB85C \uC591\uD488\uB960\uC744
      \uB192\uC5EC \uB3C4\uC7A5 \uC2DC \uC815\uD488\uC774 \uB354 \uC798 \uB098\uC635\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047878
    m_Localized: "\uD56D\uC628 \uB3C4\uC7A5\uC73C\uB85C \uACB0\uD568\uC744 \uC904\uC774\uACE0
      \uC591\uD488\uB960\uC744 \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047879
    m_Localized: "\uBE44\uC804 \uAC80\uC0AC\uB85C \uC591\uD488\uB960\uC744 \uB192\uC774\uACE0
      \uBD88\uB7C9\uC744 \uC904\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047880
    m_Localized: "\uAE08\uD615 \uC628\uB3C4\uB97C \uC548\uC815\uC2DC\uCF1C 1\uD68C
      \uC0DD\uC0B0\uB7C9\uC744 \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047881
    m_Localized: "\uACE0\uC18D \uD328\uB4DC \uC778\uC1C4\uB85C 1\uD68C \uC0DD\uC0B0\uB7C9\uC744
      \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047882
    m_Localized: "\uC9C4\uACF5 \uACBD\uD654\uB85C 1\uD68C \uC0DD\uC0B0\uB7C9\uC744
