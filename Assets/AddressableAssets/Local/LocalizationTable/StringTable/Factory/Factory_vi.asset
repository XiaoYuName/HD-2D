  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Factory_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 419bc6bcba2545441835aeaa62146887, type: 2}
  m_Metadata:
    m_Items:
    - rid: 702015471207055572
  m_TableData:
  - m_Id: 316078436638720
    m_Localized: "X\u01B0\u1EDFng gia c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998848
    m_Localized: "Gia c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998849
    m_Localized: "T\xE1i ch\u1EBF"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193152
    m_Localized: "H\u1EE3p t\xE1c <color=#F0A030>{CoopCur}</color>/{CoopMax}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193154
    m_Localized: "T\u1ED5ng chi ph\xED: "
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193155
    m_Localized: "\xA5{Price}/c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193156
    m_Localized: "\xD7{Count} c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193157
    m_Localized: "\u0110\xE3 ch\u1ECDn {Selected}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193158
    m_Localized: "C\u1EA7n gi\xFAp g\xEC kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193159
    m_Localized: "T\xEDnh n\u0103ng t\xE1i ch\u1EBF \u0111ang ph\xE1t tri\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193160
    m_Localized: "Kh\xF4ng c\xF3 s\u1EA3n ph\u1EA9m \u0111\u1EC3 ch\u1ECDn. Vui l\xF2ng
      \u0111\u1EBFn \"Qu\u1EA3n l\xFD khu\xF4n\" \u0111\u1EC3 ch\u1EBF t\u1EA1o."
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193161
    m_Localized: "X\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193162
    m_Localized: "Th\xEAm li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193163
    m_Localized: "Lo\u1EA1i s\u1EA3n ph\u1EA9m"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193164
    m_Localized: "S\u1EA3n ph\u1EA9m A"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193165
    m_Localized: "H\xE0ng c\u01A1 b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193166
    m_Localized: "S\u1EA3n ph\u1EA9m B"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193167
    m_Localized: "H\xE0ng n\xE2ng cao"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193168
    m_Localized: "S\u1EA3n ph\u1EA9m C"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193169
    m_Localized: "H\xE0ng cao c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623552
    m_Localized: "T\xECnh h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623553
    m_Localized: "\u0110i\u1EC3m s\u1ED1"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623554
    m_Localized: "T\u1EF7 l\u1EC7 ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623555
    m_Localized: "Th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623556
    m_Localized: "Th\u1EA5t b\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623557
    m_Localized: "C\u1ED1 l\xEAn!"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623558
    m_Localized: "V\xF9ng ng\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623559
    m_Localized: "Nh\u1EA5n! (Space)"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462624673792
    m_Localized: "S\u1ED1 l\u01B0\u1EE3ng gia c\xF4ng l\u1EA7n n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623561
    m_Localized: "Tho\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623562
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623564
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623566
    m_Localized: "Kh\xF4ng \u0111\u1EE7 th\u1EC3 l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623567
    m_Localized: "K\u1EBFt qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623568
    m_Localized: "V\u1EA5t v\u1EA3 r\u1ED3i~"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623569
    m_Localized: "\u0110i\u1EC3m: <color=#E8C84A>{Score}</color>\r\nTh\xE0nh c\xF4ng:
      <color=#5FD37F>{Success}</color>  Th\u1EA5t b\u1EA1i: <color=#FF5C5C>{Fail}</color>\r\nHo\xE0n
      th\xE0nh: <color=#FFA030>{Completion}%</color>\r\n\r\n<color=#B66BFF><size=120%>Nh\u1EADn
      xu: +{Reward}</size></color>"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 2088872363155456
    m_Localized: "Tr\xF2 ch\u01A1i nh\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343207071744
    m_Localized: "K\u1EBFt qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237568
    m_Localized: "Kh\xE1 \u0111\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237569
    m_Localized: "\u0110i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237570
    m_Localized: "Th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237571
    m_Localized: "T\u1EF7 l\u1EC7 ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237573
    m_Localized: "V\u1EADt ph\u1EA9m \u0111\xE3 t\u1EF1 \u0111\u1ED9ng v\xE0o t\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237574
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237575
    m_Localized: "Gi\xE1 thu h\u1ED3i:"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237576
    m_Localized: "Gi\u1EEF \u0111\u1EC3 th\xEAm nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237577
    m_Localized: "Thu nh\u1EADp d\u1EF1 ki\u1EBFn:"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237578
    m_Localized: "Thu h\u1ED3i & B\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237579
    m_Localized: "S\u1EAFp x\u1EBFp m\u1EB7c \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237580
    m_Localized: "Kh\xF4ng c\xF3 s\u1EA3n ph\u1EA9m \u0111\u1EC3 thu h\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237581
    m_Localized: "Vui l\xF2ng ch\u1ECDn s\u1EA3n ph\u1EA9m c\u1EA7n thu h\u1ED3i
      tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237582
    m_Localized: "\u0110\xE3 b\xE1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014336
    m_Localized: "N\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014337
    m_Localized: "N\xE2ng c\u1EA5p thi\u1EBFt b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014338
    m_Localized: MAX
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014339
    m_Localized: "N\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014340
    m_Localized: "T\u1EF7 l\u1EC7 \u0111\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014341
    m_Localized: "S\u1EA3n l\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014342
    m_Localized: "Hi\u1EC7u qu\u1EA3 \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014343
    m_Localized: "Kh\xF4ng \u0111\u1EE7 v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014344
    m_Localized: "\u0110\xE3 \u0111\u1EA1t c\u1EA5p t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014345
    m_Localized: "N\xE2ng c\u1EA5p th\xE0nh c\xF4ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014346
    m_Localized: "Kh\xF4ng c\xF3 thi\u1EBFt b\u1ECB \u0111\u1EC3 n\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844523659264
    m_Localized: "M\xE1y \xE9p phun servo"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047872
    m_Localized: "Ph\xF2ng s\u01A1n ki\u1EC3m nhi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047873
    m_Localized: "M\xE1y ph\xE2n lo\u1EA1i th\u1ECB gi\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047874
    m_Localized: "H\u1EC7 th\u1ED1ng ki\u1EC3m nhi\u1EC7t khu\xF4n"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047875
    m_Localized: "M\xE1y in pad AI"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047876
    m_Localized: "D\xE2y chuy\u1EC1n l\u01B0u h\xF3a ch\xE2n kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047877
    m_Localized: "\xC9p ch\xEDnh x\xE1c, t\u0103ng t\u1EF7 l\u1EC7 \u0111\u1EA1t,
      \u0111\xF3ng d\u1EA5u d\u1EC5 ra h\xE0ng chu\u1EA9n."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047878
    m_Localized: "S\u01A1n \u1ED5n nhi\u1EC7t, gi\u1EA3m l\u1ED7i, t\u0103ng t\u1EF7
      l\u1EC7 \u0111\u1EA1t."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047879
    m_Localized: "Ki\u1EC3m tra th\u1ECB gi\xE1c, t\u0103ng t\u1EF7 l\u1EC7 \u0111\u1EA1t,
      gi\u1EA3m ph\u1EBF ph\u1EA9m."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047880
    m_Localized: "\u1ED4n nhi\u1EC7t khu\xF4n, t\u0103ng s\u1EA3n l\u01B0\u1EE3ng
      m\u1ED7i l\u01B0\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047881
    m_Localized: "In pad t\u1ED1c \u0111\u1ED9 cao, t\u0103ng s\u1EA3n l\u01B0\u1EE3ng
      m\u1ED7i l\u01B0\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047882
    m_Localized: "L\u01B0u h\xF3a ch\xE2n kh\xF4ng, t\u0103ng m\u1EA1nh s\u1EA3n
      l\u01B0\u1EE3ng m\u1ED7i l\u01B0\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 4620773552545792
    m_Localized: "Qu\u1EA3n l\xFD khu\xF4n"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128591527936
    m_Localized: "M\u1EABu ch\u1EBF t\u1EA1o v\u1EADt li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128620888064
    m_Localized: Khung
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082368
    m_Localized: "H\xECnh minh h\u1ECDa"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082369
    m_Localized: "Ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082370
    m_Localized: "Tho\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082371
    m_Localized: "\u0110i\u1EC3m ch\u1EBF t\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703704952832
    m_Localized: "Gi\xE1 b\xE1n \u01B0\u1EDBc t\xEDnh: \xA5{Price}/c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 4727703730118656
    m_Localized: "Kh\xF4ng \u0111\u1EE7 h\xECnh minh h\u1ECDa"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082374
    m_Localized: "Chi ph\xED ch\u1EBF t\u1EA1o \u01B0\u1EDBc t\xEDnh: \xA5{Price}/c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 4654128625082375
    m_Localized: "Vui l\xF2ng ch\u1ECDn khung tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082376
    m_Localized: "Vui l\xF2ng \u0111\u1EB7t h\xECnh minh h\u1ECDa tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082377
    m_Localized: "Ch\u1EBF t\u1EA1o th\xE0nh c\xF4ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082378
    m_Localized: "Kh\xF4ng c\xF3 khung/h\xECnh minh h\u1ECDa kh\u1EA3 d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118657
    m_Localized: "L\u1EADt g\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118658
    m_Localized: "L\u1EDBp l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118659
    m_Localized: "L\u1EDBp xu\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118660
    m_Localized: "X\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118661
    m_Localized: "Ch\u1EC9nh \u1EA3nh"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118662
    m_Localized: "L\u1EADt v\u1EADt li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118663
    m_Localized: "Xoay v\u1EADt li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 4992012754345984
    m_Localized: Khung +{Price}
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 4992012783706112
    m_Localized: "H\xECnh minh h\u1ECDa +{Price}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 4992012783706113
    m_Localized: "\u0110\xE3 \u0111\u1EA1t gi\u1EDBi h\u1EA1n h\xECnh minh h\u1ECDa"
    m_Metadata:
      m_Items: []
  - m_Id: 7175635502882816
    m_Localized: "Th\xF4ng b\xE1o"
    m_Metadata:
      m_Items: []
  - m_Id: 7175635507077120
    m_Localized: "K\u1EBFt th\xFAc s\u1EDBm s\u1EBD kh\xF4ng nh\u1EADn \u0111\u01B0\u1EE3c
      g\xEC trong l\u01B0\u1EE3t n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7175635507077121
    m_Localized: "X\xE1c nh\u1EADn k\u1EBFt th\xFAc"
    m_Metadata:
      m_Items: []
  - m_Id: 7175635507077122
    m_Localized: "H\u1EE7y"
    m_Metadata:
      m_Items: []
  - m_Id: 7175635507077123
    m_Localized: GOOD!
    m_Metadata:
      m_Items: []
  - m_Id: 7175635507077124
    m_Localized: BAD...
    m_Metadata:
      m_Items: []
  - m_Id: 7225851119656960
    m_Localized: "T\u1ED5 h\u1EE3p n\xE0y ch\u01B0a c\xF3 c\xF4ng th\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851264
    m_Localized: "Huy hi\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851265
    m_Localized: "S\xE1ch \u1EA3nh"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851266
    m_Localized: "G\u1ED1i \xF4m"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851267
    m_Localized: "Ch\u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851268
    m_Localized: "\xC1p ph\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851269
    m_Localized: "B\u01B0u thi\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851270
    m_Localized: "Tranh cu\u1ED9n"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851271
    m_Localized: "T\xFAi v\u1EA3i canvas"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851272
    m_Localized: "B\xECa h\u1ED3 s\u01A1"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851273
    m_Localized: "\u1ED0p \u0111i\u1EC7n tho\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851274
    m_Localized: "Ch\u1ECDn v\u1EADt li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851275
    m_Localized: "Ch\u1ECDn h\xECnh minh h\u1ECDa"
    m_Metadata:
      m_Items: []
  - m_Id: 7225851123851276
    m_Localized: "Ch\u01B0a c\xF3 b\u1EA3n v\u1EBD n\xE0o, mau \u0111i gi\u1EE5c
      Maji v\u1EBD nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 7256578511069184
    m_Localized: "Hi\u1EC7u qu\u1EA3 t\u0103ng t\u1EF7 l\u1EC7 \u0111\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 7256578540429312
    m_Localized: "Hi\u1EC7u qu\u1EA3 t\u0103ng s\u1EA3n l\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7260586281787392
    m_Localized: "Gia c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7260586281787393
    m_Localized: "S\u1EA3n l\u01B0\u1EE3ng hi\u1EC7n t\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7260586281787394
    m_Localized: "{Volume}/l\u01B0\u1EE3t"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 7260586281787395
    m_Localized: "T\u1EF7 l\u1EC7 \u0111\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 7260586281787396
    m_Localized: '{Yield}%'
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 7504423453450240
    m_Localized: Standee
    m_Metadata:
      m_Items: []
  - m_Id: 7518209077927936
    m_Localized: "Quy\u1EBFt to\xE1n v\u1EADt li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 7518209082122240
    m_Localized: "L\xE0m t\u1ED1t l\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 7562247495737344
    m_Localized: "V\xE9 Laser"
    m_Metadata:
      m_Items: []
  - m_Id: 7572637822738432
    m_Localized: "Gi\xE1 d\u1EF1 ki\u1EBFn: {Price}/c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 7585017378103296
    m_Localized: "(H\xE0ng l\u1ED7i)"
    m_Metadata:
      m_Items: []
  - m_Id: 7623046998253568
    m_Localized: "Chi ph\xED ch\u1EBF t\u1EA1o \u01B0\u1EDBc t\xEDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462624673793
    m_Localized: "c\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462624673794
    m_Localized: "T\u1EF7 l\u1EC7 h\xE0ng l\u1ED7i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462624673795
    m_Localized: "S\u1EA3n ph\u1EA9m th\u1EA5t b\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868096
    m_Localized: "S\u1EA3n xu\u1EA5t ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868097
    m_Localized: "Khu \u0111\xF3ng g\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868098
    m_Localized: "C\xE1ch ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868099
    m_Localized: "Khi nh\u1EA1c b\u1EAFt \u0111\u1EA7u, s\u1EA3n ph\u1EA9m gia c\xF4ng
      s\u1EBD xu\u1EA5t hi\u1EC7n tr\xEAn b\u0103ng chuy\u1EC1n, c\u1EA7n nh\u1EA5n
      \u0111\xFAng n\xFAt khi s\u1EA3n ph\u1EA9m \u0111i qua khu \u0111\xF3ng g\xF3i,
      n\u1EBFu kh\xF4ng s\u1EBD t\xEDnh l\xE0 th\u1EA5t b\u1EA1i l\u01B0\u1EE3t n\xE0y.
      H\xE0ng l\u1ED7i c\u1EA7n ph\u1EA3i v\u1EE9t b\u1ECF, n\u1EBFu kh\xF4ng s\u1EBD
      l\xE0m k\u1EB9t m\xE1y v\xE0 \u1EA3nh h\u01B0\u1EDFng \u0111\u1EBFn c\xE1c
      s\u1EA3n ph\u1EA9m kh\xE1c c\u1EA7n gia c\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868100
    m_Localized: "Nh\u1EA5p <color=#D46270>tr\xE1i chu\u1ED9t</color> ho\u1EB7c b\u1EA5m
      <color=#D46270>\u2190</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868101
    m_Localized: "Nh\u1EA5p <color=#9FD2E0>ph\u1EA3i chu\u1ED9t</color> ho\u1EB7c
      b\u1EA5m <color=#9FD2E0>\u2192</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868102
    m_Localized: "Nh\u1EA5p <color=#B89139>gi\u1EEFa chu\u1ED9t</color> ho\u1EB7c
      b\u1EA5m <color=#B89139>\u2191</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868103
    m_Localized: "Tho\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868104
    m_Localized: "Tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868105
    m_Localized: "Ph\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913462628868106
    m_Localized: "Gi\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 7913463144767488
    m_Localized: "S\u1ED1 l\u01B0\u1EE3ng gia c\xF4ng l\u1EA7n n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 7913463144767489
    m_Localized: "c\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913463144767490
    m_Localized: "T\u1EF7 l\u1EC7 h\xE0ng l\u1ED7i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913463144767491
    m_Localized: "S\u1EA3n ph\u1EA9m th\u1EA5t b\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7913463144767492
    m_Localized: "S\u1EA3n xu\u1EA5t ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 7913463144767493
    m_Localized: "Nh\u1EA5p v\xE0o b\u1EA5t k\u1EF3 \u0111\xE2u tr\xEAn m\xE0n h\xECnh
      \u0111\u1EC3 \u0111\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7964770253660160
    m_Localized: "H\xE0ng l\u1ED7i"
    m_Metadata:
      m_Items: []
  - m_Id: 8340177511505920
    m_Localized: "Th\u1EC3 l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 8340177536671744
    m_Localized: "S\u1EA3n ph\u1EA9m \u0111\xE3 ch\u1ECDn"
    m_Metadata:
      m_Items: []
  - m_Id: 8340177536671745
    m_Localized: "Ti\xEAu hao th\u1EC3 l\u1EF1c -{Consume}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 8340177536671746
    m_Localized: "B\u1EAFt \u0111\u1EA7u gia c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 8340177536671747
    m_Localized: "Khi nh\u1EA1c b\u1EAFt \u0111\u1EA7u, s\u1EA3n ph\u1EA9m gia c\xF4ng
      s\u1EBD xu\u1EA5t hi\u1EC7n tr\xEAn b\u0103ng chuy\u1EC1n, c\u1EA7n nh\u1EA5n
      \u0111\xFAng n\xFAt khi s\u1EA3n ph\u1EA9m \u0111i qua khu \u0111\xF3ng g\xF3i,
      n\u1EBFu kh\xF4ng s\u1EBD t\xEDnh l\xE0 th\u1EA5t b\u1EA1i l\u01B0\u1EE3t n\xE0y.
      H\xE0ng l\u1ED7i c\u1EA7n ph\u1EA3i v\u1EE9t b\u1ECF, n\u1EBFu kh\xF4ng s\u1EBD
      l\xE0m k\u1EB9t m\xE1y v\xE0 \u1EA3nh h\u01B0\u1EDFng \u0111\u1EBFn c\xE1c
      s\u1EA3n ph\u1EA9m kh\xE1c c\u1EA7n gia c\xF4ng."
    m_Metadata:
      m_Items: []
