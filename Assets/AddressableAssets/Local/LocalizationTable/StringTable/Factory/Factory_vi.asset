  m_Name: Factory_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 419bc6bcba2545441835aeaa62146887, type: 2}
  m_Metadata:
    m_Items:
    - rid: 702015471207055572
  m_TableData:
  - m_Id: 316078436638720
    m_Localized: "X\u01B0\u1EDFng gia c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998848
    m_Localized: "Gia c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998849
    m_Localized: "T\xE1i ch\u1EBF"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998850
    m_Localized: "\u2460 Ch\u1ECDn li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998851
    m_Localized: "\u2461 S\u1EA3n ph\u1EA9m"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998852
    m_Localized: "\u2462 B\u1EAFt \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998853
    m_Localized: "X\u01B0\u1EDFng LV{Level}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193152
    m_Localized: "H\u1EE3p t\xE1c <color=#F0A030>{CoopCur}</color>/{CoopMax}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193153
    m_Localized: "C\u1EA5p c\xE0ng cao m\u1EDF kh\xF3a c\xE0ng nhi\u1EC1u s\u1EA3n
      ph\u1EA9m!"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193154
    m_Localized: "T\u1ED5ng chi ph\xED: "
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193155
    m_Localized: "\xA5{Price}/c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193156
    m_Localized: "\xD7{Count} c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193157
    m_Localized: "\u0110\xE3 ch\u1ECDn {Selected}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193158
    m_Localized: "C\u1EA7n gi\xFAp g\xEC kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193159
    m_Localized: "T\xEDnh n\u0103ng t\xE1i ch\u1EBF \u0111ang ph\xE1t tri\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193160
    m_Localized: "Vui l\xF2ng ch\u1ECDn s\u1EA3n ph\u1EA9m tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193161
    m_Localized: "X\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193162
    m_Localized: "Th\xEAm li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193163
    m_Localized: "Lo\u1EA1i s\u1EA3n ph\u1EA9m"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193164
    m_Localized: "S\u1EA3n ph\u1EA9m A"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193165
    m_Localized: "H\xE0ng c\u01A1 b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193166
    m_Localized: "S\u1EA3n ph\u1EA9m B"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193167
    m_Localized: "H\xE0ng n\xE2ng cao"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193168
    m_Localized: "S\u1EA3n ph\u1EA9m C"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193169
    m_Localized: "H\xE0ng cao c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623552
    m_Localized: "T\xECnh h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623553
    m_Localized: "\u0110i\u1EC3m s\u1ED1"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623554
    m_Localized: "T\u1EF7 l\u1EC7 ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623555
    m_Localized: "Th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623556
    m_Localized: "Th\u1EA5t b\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623557
    m_Localized: "C\u1ED1 l\xEAn!"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623558
    m_Localized: "V\xF9ng ng\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623559
    m_Localized: "Nh\u1EA5n! (Space)"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623560
    m_Localized: "Nh\u1EA5n khi h\xE0ng \u0111\u1EA1t chu\u1EA9n v\xE0o v\xF9ng,
      b\u1ECF qua h\xE0ng l\u1ED7i"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623561
    m_Localized: "K\u1EBFt th\xFAc"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623562
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623564
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623566
    m_Localized: "Kh\xF4ng \u0111\u1EE7 th\u1EC3 l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623567
    m_Localized: "K\u1EBFt qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623568
    m_Localized: "V\u1EA5t v\u1EA3 r\u1ED3i~"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623569
    m_Localized: "\u0110i\u1EC3m: <color=#E8C84A>{Score}</color>\r\nTh\xE0nh c\xF4ng:
      <color=#5FD37F>{Success}</color>  Th\u1EA5t b\u1EA1i: <color=#FF5C5C>{Fail}</color>\r\nHo\xE0n
      th\xE0nh: <color=#FFA030>{Completion}%</color>\r\n\r\n<color=#B66BFF><size=120%>Nh\u1EADn
      xu: +{Reward}</size></color>"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 2088872363155456
    m_Localized: "Tr\xF2 ch\u01A1i nh\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343207071744
    m_Localized: "K\u1EBFt qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237568
    m_Localized: "Kh\xE1 \u0111\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237569
    m_Localized: "\u0110i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237570
    m_Localized: "Th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237571
    m_Localized: "T\u1EF7 l\u1EC7 ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237572
    m_Localized: "H\u1EC7 s\u1ED1 gi\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237573
    m_Localized: "V\u1EADt ph\u1EA9m \u0111\xE3 t\u1EF1 \u0111\u1ED9ng v\xE0o t\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237574
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237575
    m_Localized: "Gi\u00E1 thu h\u1ED3i:"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237576
    m_Localized: "Gi\u1EEF \u0111\u1EC3 th\u00EAm nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237577
    m_Localized: "Thu nh\u1EADp d\u1EF1 ki\u1EBFn:"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237578
    m_Localized: "Thu h\u1ED3i & B\u00E1n"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237579
    m_Localized: "S\u1EAFp x\u1EBFp m\u1EB7c \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237580
    m_Localized: "Kh\u00F4ng c\u00F3 s\u1EA3n ph\u1EA9m \u0111\u1EC3 thu h\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237581
    m_Localized: "Vui l\u00F2ng ch\u1ECDn s\u1EA3n ph\u1EA9m c\u1EA7n thu h\u1ED3i tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237582
    m_Localized: "\u0110\u00E3 b\u00E1n!"
    m_Metadata:
      m_Items: []
