  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Factory_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 419bc6bcba2545441835aeaa62146887, type: 2}
  m_Metadata:
    m_Items:
    - rid: 702015471207055572
  m_TableData:
  - m_Id: 316078436638720
    m_Localized: "X\u01B0\u1EDFng gia c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998848
    m_Localized: "Gia c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998849
    m_Localized: "T\xE1i ch\u1EBF"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998850
    m_Localized: "\u2460 Ch\u1ECDn li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998851
    m_Localized: "\u2461 S\u1EA3n ph\u1EA9m"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998852
    m_Localized: "\u2462 B\u1EAFt \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 316078465998853
    m_Localized: "X\u01B0\u1EDFng LV{Level}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193152
    m_Localized: "H\u1EE3p t\xE1c <color=#F0A030>{CoopCur}</color>/{CoopMax}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193153
    m_Localized: "C\u1EA5p c\xE0ng cao m\u1EDF kh\xF3a c\xE0ng nhi\u1EC1u s\u1EA3n
      ph\u1EA9m!"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193154
    m_Localized: "T\u1ED5ng chi ph\xED: "
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193155
    m_Localized: "\xA5{Price}/c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193156
    m_Localized: "\xD7{Count} c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193157
    m_Localized: "\u0110\xE3 ch\u1ECDn {Selected}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 316078470193158
    m_Localized: "C\u1EA7n gi\xFAp g\xEC kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193159
    m_Localized: "T\xEDnh n\u0103ng t\xE1i ch\u1EBF \u0111ang ph\xE1t tri\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193160
    m_Localized: "Kh\u00F4ng c\u00F3 s\u1EA3n ph\u1EA9m \u0111\u1EC3 ch\u1ECDn. Vui l\u00F2ng \u0111\u1EBFn \"Qu\u1EA3n l\u00FD khu\u00F4n\" \u0111\u1EC3 ch\u1EBF t\u1EA1o."
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193161
    m_Localized: "X\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193162
    m_Localized: "Th\xEAm li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193163
    m_Localized: "Lo\u1EA1i s\u1EA3n ph\u1EA9m"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193164
    m_Localized: "S\u1EA3n ph\u1EA9m A"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193165
    m_Localized: "H\xE0ng c\u01A1 b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193166
    m_Localized: "S\u1EA3n ph\u1EA9m B"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193167
    m_Localized: "H\xE0ng n\xE2ng cao"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193168
    m_Localized: "S\u1EA3n ph\u1EA9m C"
    m_Metadata:
      m_Items: []
  - m_Id: 316078470193169
    m_Localized: "H\xE0ng cao c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623552
    m_Localized: "T\xECnh h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623553
    m_Localized: "\u0110i\u1EC3m s\u1ED1"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623554
    m_Localized: "T\u1EF7 l\u1EC7 ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623555
    m_Localized: "Th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623556
    m_Localized: "Th\u1EA5t b\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623557
    m_Localized: "C\u1ED1 l\xEAn!"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623558
    m_Localized: "V\xF9ng ng\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623559
    m_Localized: "Nh\u1EA5n! (Space)"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623560
    m_Localized: "Nh\u1EA5n khi h\xE0ng \u0111\u1EA1t chu\u1EA9n v\xE0o v\xF9ng,
      b\u1ECF qua h\xE0ng l\u1ED7i"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623561
    m_Localized: "K\u1EBFt th\xFAc"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623562
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623564
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623566
    m_Localized: "Kh\xF4ng \u0111\u1EE7 th\u1EC3 l\u1EF1c"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623567
    m_Localized: "K\u1EBFt qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623568
    m_Localized: "V\u1EA5t v\u1EA3 r\u1ED3i~"
    m_Metadata:
      m_Items: []
  - m_Id: 316078889623569
    m_Localized: "\u0110i\u1EC3m: <color=#E8C84A>{Score}</color>\r\nTh\xE0nh c\xF4ng:
      <color=#5FD37F>{Success}</color>  Th\u1EA5t b\u1EA1i: <color=#FF5C5C>{Fail}</color>\r\nHo\xE0n
      th\xE0nh: <color=#FFA030>{Completion}%</color>\r\n\r\n<color=#B66BFF><size=120%>Nh\u1EADn
      xu: +{Reward}</size></color>"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 2088872363155456
    m_Localized: "Tr\xF2 ch\u01A1i nh\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343207071744
    m_Localized: "K\u1EBFt qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237568
    m_Localized: "Kh\xE1 \u0111\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237569
    m_Localized: "\u0110i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237570
    m_Localized: "Th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237571
    m_Localized: "T\u1EF7 l\u1EC7 ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237572
    m_Localized: "H\u1EC7 s\u1ED1 gi\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237573
    m_Localized: "V\u1EADt ph\u1EA9m \u0111\xE3 t\u1EF1 \u0111\u1ED9ng v\xE0o t\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237574
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237575
    m_Localized: "Gi\xE1 thu h\u1ED3i:"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237576
    m_Localized: "Gi\u1EEF \u0111\u1EC3 th\xEAm nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237577
    m_Localized: "Thu nh\u1EADp d\u1EF1 ki\u1EBFn:"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237578
    m_Localized: "Thu h\u1ED3i & B\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237579
    m_Localized: "S\u1EAFp x\u1EBFp m\u1EB7c \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237580
    m_Localized: "Kh\xF4ng c\xF3 s\u1EA3n ph\u1EA9m \u0111\u1EC3 thu h\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237581
    m_Localized: "Vui l\xF2ng ch\u1ECDn s\u1EA3n ph\u1EA9m c\u1EA7n thu h\u1ED3i
      tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 3177343232237582
    m_Localized: "\u0110\xE3 b\xE1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014336
    m_Localized: "N\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014337
    m_Localized: "N\xE2ng c\u1EA5p thi\u1EBFt b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014338
    m_Localized: MAX
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014339
    m_Localized: "N\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014340
    m_Localized: "T\u1EF7 l\u1EC7 \u0111\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014341
    m_Localized: "S\u1EA3n l\u01B0\u1EE3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014342
    m_Localized: "Hi\u1EC7u qu\u1EA3 \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014343
    m_Localized: "Kh\xF4ng \u0111\u1EE7 v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014344
    m_Localized: "\u0110\xE3 \u0111\u1EA1t c\u1EA5p t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014345
    m_Localized: "N\xE2ng c\u1EA5p th\xE0nh c\xF4ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 4332655008014346
    m_Localized: "Kh\xF4ng c\xF3 thi\u1EBFt b\u1ECB \u0111\u1EC3 n\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844523659264
    m_Localized: "M\xE1y \xE9p phun servo"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047872
    m_Localized: "Ph\xF2ng s\u01A1n ki\u1EC3m nhi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047873
    m_Localized: "M\xE1y ph\xE2n lo\u1EA1i th\u1ECB gi\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047874
    m_Localized: "H\u1EC7 th\u1ED1ng ki\u1EC3m nhi\u1EC7t khu\xF4n"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047875
    m_Localized: "M\xE1y in pad AI"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047876
    m_Localized: "D\xE2y chuy\u1EC1n l\u01B0u h\xF3a ch\xE2n kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047877
    m_Localized: "\xC9p ch\xEDnh x\xE1c, t\u0103ng t\u1EF7 l\u1EC7 \u0111\u1EA1t,
      \u0111\xF3ng d\u1EA5u d\u1EC5 ra h\xE0ng chu\u1EA9n."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047878
    m_Localized: "S\u01A1n \u1ED5n nhi\u1EC7t, gi\u1EA3m l\u1ED7i, t\u0103ng t\u1EF7
      l\u1EC7 \u0111\u1EA1t."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047879
    m_Localized: "Ki\u1EC3m tra th\u1ECB gi\xE1c, t\u0103ng t\u1EF7 l\u1EC7 \u0111\u1EA1t,
      gi\u1EA3m ph\u1EBF ph\u1EA9m."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047880
    m_Localized: "\u1ED4n nhi\u1EC7t khu\xF4n, t\u0103ng s\u1EA3n l\u01B0\u1EE3ng
      m\u1ED7i l\u01B0\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047881
    m_Localized: "In pad t\u1ED1c \u0111\u1ED9 cao, t\u0103ng s\u1EA3n l\u01B0\u1EE3ng
      m\u1ED7i l\u01B0\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 4344844532047882
    m_Localized: "L\u01B0u h\xF3a ch\xE2n kh\xF4ng, t\u0103ng m\u1EA1nh s\u1EA3n
      l\u01B0\u1EE3ng m\u1ED7i l\u01B0\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 4620773552545792
    m_Localized: "Qu\u1EA3n l\xFD khu\xF4n"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128591527936
    m_Localized: "M\u1EABu ch\u1EBF t\u1EA1o v\u1EADt li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128620888064
    m_Localized: Khung
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082368
    m_Localized: "Nh\xE3n d\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082369
    m_Localized: "Ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082370
    m_Localized: "Tho\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082371
    m_Localized: "\u0110i\u1EC3m ch\u1EBF t\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703704952832
    m_Localized: "Gi\xE1 b\xE1n \u01B0\u1EDBc t\xEDnh: \xA5{Price}/c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 4727703730118656
    m_Localized: "Kh\xF4ng \u0111\u1EE7 nh\xE3n d\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082374
    m_Localized: "Chi ph\xED ch\u1EBF t\u1EA1o \u01B0\u1EDBc t\xEDnh: \xA5{Price}/c\xE1i"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 4654128625082375
    m_Localized: "Vui l\xF2ng ch\u1ECDn khung tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082376
    m_Localized: "Vui l\xF2ng \u0111\u1EB7t nh\xE3n d\xE1n tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082377
    m_Localized: "Ch\u1EBF t\u1EA1o th\xE0nh c\xF4ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 4654128625082378
    m_Localized: "Kh\xF4ng c\xF3 khung/nh\xE3n d\xE1n kh\u1EA3 d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118657
    m_Localized: "L\u1EADt g\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118658
    m_Localized: "L\u1EDBp l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118659
    m_Localized: "L\u1EDBp xu\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118660
    m_Localized: "X\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118661
    m_Localized: "Ch\u1EC9nh \u1EA3nh"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118662
    m_Localized: "L\u1EADt v\u1EADt li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 4727703730118663
    m_Localized: "Xoay v\u1EADt li\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 4992012754345984
    m_Localized: Khung +{Price}
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 4992012783706112
    m_Localized: "Nh\xE3n d\xE1n +{Price}"
    m_Metadata:
      m_Items:
      - rid: 702015471207055572
  - m_Id: 4992012783706113
    m_Localized: "\u0110\xE3 \u0111\u1EA1t gi\u1EDBi h\u1EA1n nh\xE3n d\xE1n"
    m_Metadata:
      m_Items: []
