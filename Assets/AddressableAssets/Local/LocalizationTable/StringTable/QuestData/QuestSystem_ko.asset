      m_Items: []
  - m_Id: 1792995606126601
    m_Localized: "\uD018\uC2A4\uD2B8 \uBCF4\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1792995606126602
    m_Localized: "\uCD94\uAC00 \uBCF4\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1792995606126603
    m_Localized: "\uCD94\uAC00 \uBAA9\uD45C \uB2EC\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1792995606126604
    m_Localized: "\uCD94\uAC00 \uBAA9\uD45C \uBBF8\uB2EC\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1792995606126605
    m_Localized: "\uD018\uC2A4\uD2B8 \uC218\uB77D"
    m_Metadata:
      m_Items: []
  - m_Id: 1792995606126606
    m_Localized: "\uD018\uC2A4\uD2B8 \uC644\uB8CC \uBCF4\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1792995606126607
    m_Localized: "\uCC55\uD130 \uBCF4\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1792995606126608
    m_Localized: "\uC218\uB839 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1792995606126609
    m_Localized: "\uD018\uC2A4\uD2B8 \uCC55\uD130\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860160
    m_Localized: "\uC0C8\uB0B4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860161
    m_Localized: "\uC774\uACF3\uC5D0\uC11C \uC774\uD2C0\uC744 \uBCF4\uB0B8 \uB4A4
      \uBBF8\uB2C8\uAC8C\uC784\uC744 \uB450 \uD310 \uC990\uACA8 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860162
    m_Localized: "\uD658\uACBD \uC775\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860163
    m_Localized: "\uC774 \uAD6C\uC5ED\uC744 \uB5A0\uB098\uAE30 \uC804\uC5D0 \uBBF8\uB2C8\uAC8C\uC784\uC744
      \uB450 \uD310 \uC774\uAE30\uACE0 \uC0AC\uB78C\uB4E4\uACFC \uC774\uC57C\uAE30\uD574
      \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860164
    m_Localized: "\uC791\uC740 \uC131\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860165
    m_Localized: "\uC120\uBB3C\uC744 \uD558\uB098 \uACE8\uB77C \uC804\uD558\uACE0
      \uC0C1\uB300\uC758 \uBC18\uC751\uC744 \uC0B4\uD3B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860166
    m_Localized: "\uC7A0\uC2DC\uB9CC \uAE30\uB2E4\uB824"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860167
    m_Localized: "\uC774\uACF3\uC5D0 \uC870\uAE08 \uB354 \uBA38\uBB3C\uBA74 \uC0C8\uB85C\uC6B4
      \uAC83\uC744 \uBC1C\uACAC\uD560\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860168
    m_Localized: "\uC7A5\uBCF4\uAE30 \uBAA9\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860169
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C \uBB3C\uAC74\uC744 \uC0AC\uACE0, \uC5EC\uBD84\uC744
      \uCC59\uACA8 \uB450\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996096860170
    m_Localized: "{Value}\uC77C\uCC28\uAE4C\uC9C0 \uC9C4\uD589"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 1792996101054464
    m_Localized: "\uC9C0\uC815\uB41C \uB300\uD654 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054465
    m_Localized: "\uD018\uC2A4\uD2B8 \u300C{QuestName}\u300D \uC644\uB8CC"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 1792996101054466
    m_Localized: "{ItemName} \xD7{Value} \uBCF4\uC720 ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 1792996101054467
    m_Localized: "\uBBF8\uB2C8\uAC8C\uC784 {Value}\uD68C \uC644\uB8CC ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 1792996101054468
    m_Localized: "\uBBF8\uB2C8\uAC8C\uC784 {Value}\uD68C \uC2B9\uB9AC ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 1792996101054469
    m_Localized: "\uBBF8\uB2C8\uAC8C\uC784 {Value}\uD68C \uD328\uBC30 ({Progress})"
    m_Metadata:
