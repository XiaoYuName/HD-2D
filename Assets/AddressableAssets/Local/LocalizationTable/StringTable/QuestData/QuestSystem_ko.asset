  m_TableData:
  - m_Id: 730682077732864
    m_Localized: "\uC0C8\uB0B4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 730682111287296
    m_Localized: "\uC774\uACF3\uC5D0\uC11C \uC774\uD2C0\uC744 \uBCF4\uB0B8 \uB4A4
      \uBBF8\uB2C8\uAC8C\uC784\uC744 \uB450 \uD310 \uC990\uACA8 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 730682115481600
    m_Localized: "\uD658\uACBD \uC775\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 730682115481601
    m_Localized: "\uC774 \uAD6C\uC5ED\uC744 \uB5A0\uB098\uAE30 \uC804\uC5D0 \uBBF8\uB2C8\uAC8C\uC784\uC744
      \uB450 \uD310 \uC774\uAE30\uACE0 \uC0AC\uB78C\uB4E4\uACFC \uC774\uC57C\uAE30\uD574
      \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 730682119675904
    m_Localized: "\uC791\uC740 \uC131\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 730682119675905
    m_Localized: "\uC120\uBB3C\uC744 \uD558\uB098 \uACE8\uB77C \uC804\uD558\uACE0
      \uC0C1\uB300\uC758 \uBC18\uC751\uC744 \uC0B4\uD3B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 730682119675906
    m_Localized: "\uC7A0\uC2DC\uB9CC \uAE30\uB2E4\uB824"
    m_Metadata:
      m_Items: []
  - m_Id: 730682119675907
    m_Localized: "\uC774\uACF3\uC5D0 \uC870\uAE08 \uB354 \uBA38\uBB3C\uBA74 \uC0C8\uB85C\uC6B4
      \uAC83\uC744 \uBC1C\uACAC\uD560\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 730682119675908
    m_Localized: "\uC7A5\uBCF4\uAE30 \uBAA9\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 730682119675909
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C \uBB3C\uAC74\uC744 \uC0AC\uACE0, \uC5EC\uBD84\uC744
      \uCC59\uACA8 \uB450\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 730682119675910
