      m_Items: []
  - m_Id: 2429337696460815
    m_Localized: "\uD638\uAC10 \uB808\uBCA8"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460816
    m_Localized: "{CharacterName}\uC758 {PropName}\uC744(\uB97C) {Value}\uAE4C\uC9C0
      \uC62C\uB9AC\uAE30 ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337696460817
    m_Localized: "\uC0C8\uB0B4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460818
    m_Localized: "\uC774\uACF3\uC5D0\uC11C \uC774\uD2C0\uC744 \uBCF4\uB0B8 \uB4A4
      \uBBF8\uB2C8\uAC8C\uC784\uC744 \uB450 \uD310 \uC990\uACA8 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460819
    m_Localized: "\uD658\uACBD \uC775\uD788\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460820
    m_Localized: "\uC774 \uAD6C\uC5ED\uC744 \uB5A0\uB098\uAE30 \uC804\uC5D0 \uBBF8\uB2C8\uAC8C\uC784\uC744
      \uB450 \uD310 \uC774\uAE30\uACE0 \uC0AC\uB78C\uB4E4\uACFC \uC774\uC57C\uAE30\uD574
      \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460821
    m_Localized: "\uC791\uC740 \uC131\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460822
    m_Localized: "\uC120\uBB3C\uC744 \uD558\uB098 \uACE8\uB77C \uC804\uD558\uACE0
      \uC0C1\uB300\uC758 \uBC18\uC751\uC744 \uC0B4\uD3B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460823
    m_Localized: "\uC7A0\uC2DC\uB9CC \uAE30\uB2E4\uB824"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460824
    m_Localized: "\uC774\uACF3\uC5D0 \uC870\uAE08 \uB354 \uBA38\uBB3C\uBA74 \uC0C8\uB85C\uC6B4
      \uAC83\uC744 \uBC1C\uACAC\uD560\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460825
    m_Localized: "\uC7A5\uBCF4\uAE30 \uBAA9\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460826
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C \uBB3C\uAC74\uC744 \uC0AC\uACE0, \uC5EC\uBD84\uC744
      \uCC59\uACA8 \uB450\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460827
    m_Localized: "\uB9C8\uC744\uC5D0 \uC790\uB9AC\uB97C \uC7A1\uACE0 {Value}\uC77C\uC744
      \uC9C0\uB0B4\uAE30 ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337696460828
    m_Localized: "\uB364\uC73C\uB85C \uBBF8\uB2C8\uAC8C\uC784 {Value}\uD310 \uC2B9\uB9AC
      ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337704849408
    m_Localized: "\uBBF8\uB2C8\uAC8C\uC784\uC5D0\uC11C {Value}\uD310 \uC2B9\uB9AC
      ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337704849409
    m_Localized: "\uC774\uC57C\uAE30\uB97C \uD55C \uBC88 \uB354 \uB098\uB204\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849410
    m_Localized: "{ItemName}\uC744(\uB97C) \uACE8\uB77C {CharacterName}\uC5D0\uAC8C
      \uC804\uD558\uAE30 ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337704849411
    m_Localized: "{ItemName}\uC744(\uB97C) \uD55C \uBC88 \uB354 \uC120\uBB3C\uD558\uAE30
      ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337704849412
    m_Localized: "\uAE30\uD68C\uB97C \uBD10\uC11C \uADF8 \uC774\uC57C\uAE30\uB97C
      \uB05D\uAE4C\uC9C0 \uB4E3\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849413
    m_Localized: "\uB364\uC73C\uB85C \u300C{QuestName}\u300D\uB3C4 \uC644\uB8CC\uD558\uAE30"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337704849414
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C {ItemName}\uC744(\uB97C) \uC0AC \uC624\uAE30
      ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337704849415
    m_Localized: "{ItemName} \xD7{Value}\uC744(\uB97C) \uD56D\uC0C1 \uC9C0\uB2C8\uAE30
      ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337704849416
    m_Localized: "{CharacterName}\uC758 {PropName}\uC744(\uB97C) {Value}\uAE4C\uC9C0
      \uC313\uAE30 ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 2429337704849417
    m_Localized: "\uB9C8\uC744\uC5D0 \uB3C4\uCC29"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849418
    m_Localized: "\uB9C8\uC744\uC5D0 \uC628 \uCCAB \uBA70\uCE60. \uC8FC\uBCC0\uC744
      \uC775\uD788\uBA74\uC11C \uBA87 \uC0AC\uB78C\uACFC\uB3C4 \uC778\uC0AC\uB97C
      \uB098\uB220 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849419
    m_Localized: "\uC774\uC6C3\uACFC\uC758 \uAD50\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849420
    m_Localized: "\uC790\uC8FC \uC624\uAC00\uC57C \uC815\uC774 \uC313\uC778\uB2E4.
      \uC791\uC740 \uC120\uBB3C\uACFC \uC18C\uC18C\uD55C \uC774\uC57C\uAE30\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849421
    m_Localized: "\uC19C\uC528 \uC2DC\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849422
    m_Localized: "\uB9C8\uC744\uC5D4 \uC18C\uC18C\uD55C \uB180\uAC70\uB9AC\uAC00
      \uB9CE\uB2E4. \uBA87 \uAC00\uC9C0 \uD574 \uBCF4\uC790. \uC774\uAE30\uB4E0 \uC9C0\uB4E0
      \uB2E4 \uACBD\uD5D8\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849423
    m_Localized: "\uC2EC\uBD80\uB984\uACFC \uC7A5\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849424
    m_Localized: "\uBB3C\uAC74\uC740 \uB204\uAD70\uAC00 \uC0AC\uC640\uC57C \uD558\uACE0,
      \uBC1C\uD488\uB3C4 \uB204\uAD70\uAC00\uB294 \uD314\uC544\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849425
    m_Localized: "\uC774\uC5B4\uC9C0\uB294 \uB0A0\uB4E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849426
    m_Localized: "\uD560 \uC77C\uC744 \uD558\uB098\uC529 \uD574\uB0B4\uB2E4 \uBCF4\uBA74
      \uD558\uB8E8\uD558\uB8E8\uAC00 \uC9C0\uB098\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2429338149445632
