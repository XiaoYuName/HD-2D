  - m_Id: 1792996101054474
    m_Localized: "{ItemName} \xD7{Value} \uAD6C\uB9E4 ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 1792996101054475
    m_Localized: "\uC544\uBB34 \uC544\uC774\uD15C\uC774\uB098 \xD7{Value} \uAD6C\uB9E4
      ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 1792996101054476
    m_Localized: "\uAE30\uBD84"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054477
    m_Localized: "\uD638\uAC10\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054478
    m_Localized: "\uD638\uAC10 \uB808\uBCA8"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054479
    m_Localized: "{CharacterName}\uC758 {PropName}\uC744(\uB97C) {Value}\uAE4C\uC9C0
      \uC62C\uB9AC\uAE30 ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805609
  - m_Id: 1792996101054480
    m_Localized: "\uB9C8\uC744\uC5D0 \uB3C4\uCC29"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054481
    m_Localized: "\uB9C8\uC744\uC5D0 \uC628 \uCCAB \uBA70\uCE60. \uC8FC\uBCC0\uC744
      \uC775\uD788\uBA74\uC11C \uBA87 \uC0AC\uB78C\uACFC\uB3C4 \uC778\uC0AC\uB97C
      \uB098\uB220 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054482
    m_Localized: "\uC774\uC6C3\uACFC\uC758 \uAD50\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054483
    m_Localized: "\uC790\uC8FC \uC624\uAC00\uC57C \uC815\uC774 \uC313\uC778\uB2E4.
      \uC791\uC740 \uC120\uBB3C\uACFC \uC18C\uC18C\uD55C \uC774\uC57C\uAE30\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054484
    m_Localized: "\uC19C\uC528 \uC2DC\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054485
    m_Localized: "\uB9C8\uC744\uC5D4 \uC18C\uC18C\uD55C \uB180\uAC70\uB9AC\uAC00
      \uB9CE\uB2E4. \uBA87 \uAC00\uC9C0 \uD574 \uBCF4\uC790. \uC774\uAE30\uB4E0 \uC9C0\uB4E0
      \uB2E4 \uACBD\uD5D8\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054486
    m_Localized: "\uC2EC\uBD80\uB984\uACFC \uC7A5\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054487
    m_Localized: "\uBB3C\uAC74\uC740 \uB204\uAD70\uAC00 \uC0AC\uC640\uC57C \uD558\uACE0,
      \uBC1C\uD488\uB3C4 \uB204\uAD70\uAC00\uB294 \uD314\uC544\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054488
    m_Localized: "\uC774\uC5B4\uC9C0\uB294 \uB0A0\uB4E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054489
    m_Localized: "\uD560 \uC77C\uC744 \uD558\uB098\uC529 \uD574\uB0B4\uB2E4 \uBCF4\uBA74
      \uD558\uB8E8\uD558\uB8E8\uAC00 \uC9C0\uB098\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1792996549844992
