    m_Localized: "\u0E02\u0E2D\u0E07\u0E01\u0E47\u0E15\u0E49\u0E2D\u0E07\u0E21\u0E35\u0E04\u0E19\u0E44\u0E1B\u0E0B\u0E37\u0E49\u0E2D
