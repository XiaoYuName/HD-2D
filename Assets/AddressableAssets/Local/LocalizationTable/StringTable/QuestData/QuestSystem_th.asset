    m_Localized: "\u0E23\u0E30\u0E14\u0E31\u0E1A\u0E04\u0E27\u0E32\u0E21\u0E2A\u0E19\u0E34\u0E17"
    m_Metadata:
      m_Items: []
  - m_Id: 1792996101054479
    m_Localized: "\u0E40\u0E1E\u0E34\u0E48\u0E21{PropName}\u0E02\u0E2D\u0E07 {CharacterName}
