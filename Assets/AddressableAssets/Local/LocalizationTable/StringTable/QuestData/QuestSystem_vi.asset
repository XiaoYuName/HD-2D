    - rid: 3166046073766805612
  m_TableData:
  - m_Id: 2429337163784192
    m_Localized: "Danh s\xE1ch nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337239281664
    m_Localized: "Ch\u01B0a c\xF3 nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337239281665
    m_Localized: "Tr\u1EA1ng th\xE1i nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337239281666
    m_Localized: "Ch\u01B0a nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475968
    m_Localized: "\u0110ang th\u1EF1c hi\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475969
    m_Localized: "Ch\u1EDD n\u1ED9p"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475970
    m_Localized: "\u0110\xE3 ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475971
    m_Localized: "Ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475972
    m_Localized: "M\u1EE5c ti\xEAu nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475973
    m_Localized: "M\u1EE5c ti\xEAu v\u01B0\u1EE3t m\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475974
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475975
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng v\u01B0\u1EE3t m\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475976
    m_Localized: "\u0110\xE3 \u0111\u1EA1t m\u1EE5c ti\xEAu v\u01B0\u1EE3t m\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475977
    m_Localized: "Ch\u01B0a \u0111\u1EA1t m\u1EE5c ti\xEAu v\u01B0\u1EE3t m\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475978
    m_Localized: "Nh\u1EADn nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475979
    m_Localized: "N\u1ED9p nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475980
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng ch\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475981
    m_Localized: "\u0110\xE3 nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475982
    m_Localized: "Ch\u01B0a c\xF3 nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475983
    m_Localized: "Nhi\u1EC7m v\u1EE5 {Value}"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337243475984
    m_Localized: "\u0110i\u1EC1u ki\u1EC7n: {Desc}"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337243475985
    m_Localized: "C\xF2n {Value} ph\u1EA7n n\u1EEFa"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337243475986
    m_Localized: "\u0110\u1ED3ng \xFD"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475987
    m_Localized: "Th\u01B0\u1EDFng m\u1EE5c ti\xEAu"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475988
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng \u0111\xE3 v\xE0o t\xFAi c\u1EE7a b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337243475989
    m_Localized: "Nhi\u1EC7m v\u1EE5: {QuestName}"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337243475990
    m_Localized: "H\u1EA1ng m\u1EE5c: {QuestName}"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337243475991
    m_Localized: "M\u1EE5c ti\xEAu {Value}: {Desc}"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460800
    m_Localized: "Ch\u01A1i \u0111\u1EBFn ng\xE0y th\u1EE9 {Value} ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460801
    m_Localized: "Ho\xE0n th\xE0nh \u0111o\u1EA1n h\u1ED9i tho\u1EA1i ch\u1EC9 \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460802
    m_Localized: "Ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5 \"{QuestName}\""
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460803
    m_Localized: "S\u1EDF h\u1EEFu {ItemName} \xD7{Value} ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460804
    m_Localized: "Ho\xE0n th\xE0nh tr\xF2 ch\u01A1i nh\u1ECF {Value} l\u1EA7n ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460805
    m_Localized: "Th\u1EAFng tr\xF2 ch\u01A1i nh\u1ECF {Value} l\u1EA7n ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460806
    m_Localized: "Thua tr\xF2 ch\u01A1i nh\u1ECF {Value} l\u1EA7n ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460807
    m_Localized: "Tr\xF2 chuy\u1EC7n v\u1EDBi {CharacterName} {Value} l\u1EA7n ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460808
    m_Localized: "Mang theo {ItemName} tr\xF2 chuy\u1EC7n v\u1EDBi {CharacterName}
      {Value} l\u1EA7n ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460809
    m_Localized: "T\u1EB7ng {ItemName} cho {CharacterName} {Value} l\u1EA7n ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460810
    m_Localized: "T\u1EB7ng qu\xE0 cho {CharacterName} {Value} l\u1EA7n ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460811
    m_Localized: "Mua {ItemName} \xD7{Value} ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460812
    m_Localized: "Mua v\u1EADt ph\u1EA9m b\u1EA5t k\u1EF3 \xD7{Value} ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460813
    m_Localized: "T\xE2m tr\u1EA1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460814
    m_Localized: "Thi\u1EC7n c\u1EA3m"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460815
    m_Localized: "C\u1EA5p thi\u1EC7n c\u1EA3m"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460816
    m_Localized: "N\xE2ng {PropName} c\u1EE7a {CharacterName} l\xEAn {Value} ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460817
    m_Localized: "Ng\u01B0\u1EDDi m\u1EDBi \u0111\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460818
    m_Localized: "\u1EDE l\u1EA1i \u0111\xE2y hai ng\xE0y, r\u1ED3i ch\u01A1i hai
      v\xE1n tr\xF2 ch\u01A1i nh\u1ECF \u0111\u1EC3 th\u01B0 gi\xE3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460819
    m_Localized: "L\xE0m quen m\xF4i tr\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460820
    m_Localized: "Tr\u01B0\u1EDBc khi r\u1EDDi khu v\u1EF1c n\xE0y, h\xE3y th\u1EAFng
      hai v\xE1n tr\xF2 ch\u01A1i nh\u1ECF r\u1ED3i tr\xF2 chuy\u1EC7n v\u1EDBi m\u1ECDi
      ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460821
    m_Localized: "M\u1ED9t ch\xFAt t\u1EA5m l\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460822
    m_Localized: "Ch\u1ECDn m\u1ED9t m\xF3n qu\xE0 mang t\u1EB7ng, r\u1ED3i xem ph\u1EA3n
      \u1EE9ng c\u1EE7a h\u1ECD."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460823
    m_Localized: "Ch\u1EDD m\u1ED9t l\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460824
    m_Localized: "N\xE1n l\u1EA1i \u0111\xE2y th\xEAm ch\xFAt n\u1EEFa, bi\u1EBFt
      \u0111\xE2u s\u1EBD c\xF3 ph\xE1t hi\u1EC7n m\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460825
    m_Localized: "Danh s\xE1ch mua s\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460826
    m_Localized: "\u0110\u1EBFn c\u1EEDa h\xE0ng mua ch\xFAt \u0111\u1ED3, nh\u1EDB
      mang theo m\u1ED9t ph\u1EA7n d\u1EF1 ph\xF2ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337696460827
    m_Localized: "An c\u01B0 \u1EDF th\u1ECB tr\u1EA5n \u0111\u1EE7 {Value} ng\xE0y
      ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337696460828
    m_Localized: "Th\u1EAFng th\xEAm {Value} v\xE1n tr\xF2 ch\u01A1i nh\u1ECF ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337704849408
    m_Localized: "Th\u1EAFng {Value} v\xE1n tr\xF2 ch\u01A1i nh\u1ECF ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337704849409
    m_Localized: "Tr\xF2 chuy\u1EC7n th\xEAm m\u1ED9t \u0111o\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849410
    m_Localized: "Ch\u1ECDn {ItemName} mang t\u1EB7ng {CharacterName} ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337704849411
    m_Localized: "T\u1EB7ng {ItemName} th\xEAm m\u1ED9t l\u1EA7n ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337704849412
    m_Localized: "T\xECm d\u1ECBp n\xF3i h\u1EBFt c\xE2u chuy\u1EC7n \u0111\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849413
    m_Localized: "Ho\xE0n th\xE0nh lu\xF4n \"{QuestName}\""
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337704849414
    m_Localized: "\u0110\u1EBFn c\u1EEDa h\xE0ng mua {ItemName} v\u1EC1 ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337704849415
    m_Localized: "Lu\xF4n mang theo {ItemName} \xD7{Value} ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337704849416
    m_Localized: "Vun \u0111\u1EAFp {PropName} c\u1EE7a {CharacterName} l\xEAn {Value}
      ({Progress})"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429337704849417
    m_Localized: "\u0110\u1EB7t ch\xE2n \u0111\u1EBFn th\u1ECB tr\u1EA5n"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849418
    m_Localized: "Nh\u1EEFng ng\xE0y \u0111\u1EA7u \u1EDF th\u1ECB tr\u1EA5n: \u0111i
      m\u1ED9t v\xF2ng cho quen \u0111\u01B0\u1EDDng v\xE0 l\xE0m quen v\xE0i ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849419
    m_Localized: "T\xECnh l\xE0ng ngh\u0129a x\xF3m"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849420
    m_Localized: "Qua l\u1EA1i th\u01B0\u1EDDng xuy\xEAn m\u1EDBi th\xE2n. T\u1EB7ng
      ch\xFAt qu\xE0 nh\u1ECF, tr\xF2 chuy\u1EC7n d\u0103m c\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849421
    m_Localized: "Th\u1EED s\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849422
    m_Localized: "Th\u1ECB tr\u1EA5n c\xF3 l\u1EAFm tr\xF2 hay. Th\u1EED v\xE0i th\u1EE9
      xem \u2014 th\u1EAFng thua \u0111\u1EC1u l\xE0 kinh nghi\u1EC7m."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849423
    m_Localized: "Ch\u1EA1y vi\u1EC7c v\xE0 mua s\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849424
    m_Localized: "\u0110\u1ED3 th\xEC ph\u1EA3i c\xF3 ng\u01B0\u1EDDi \u0111i mua,
      \u0111\u01B0\u1EDDng th\xEC ph\u1EA3i c\xF3 ng\u01B0\u1EDDi \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849425
    m_Localized: "Ng\xE0y th\xE1ng tr\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849426
    m_Localized: "Vi\u1EC7c c\u1EA7n l\xE0m c\u1EE9 xong d\u1EA7n, ng\xE0y th\xE1ng
      c\u0169ng tr\xF4i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 2429338149445632
    m_Localized: "{ItemName} \xD7{Value}"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429338149445633
    m_Localized: Xu +{Value}
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429338149445634
    m_Localized: "Xu tr\xF2 ch\u01A1i +{Value}"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429338149445635
    m_Localized: "{CharacterName} Thi\u1EC7n c\u1EA3m +{Value}"
    m_Metadata:
      m_Items:
      - rid: 3166046073766805612
  - m_Id: 2429338149445636
    m_Localized: Xu
    m_Metadata:
      m_Items: []
  - m_Id: 2429338149445637
    m_Localized: "Xu tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 2429338149445638
    m_Localized: "Thi\u1EC7n c\u1EA3m"
    m_Metadata:
      m_Items: []
