    m_Localized: "\u3053\u3053\u3067\u4E8C\u65E5\u9593\u904E\u3054\u3057\u3066\u304B\u3089\u3001\u30DF\u30CB\u30B2\u30FC\u30E0\u30922\u56DE\u904A\u3093\u3067\u4E00\u606F\u3064\u3053\u3046\u3002"
