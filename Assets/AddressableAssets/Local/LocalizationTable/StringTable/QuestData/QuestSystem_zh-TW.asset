      m_Items:
      - rid: 3166046073766805606
  - m_Id: 2429337696460828
    m_Localized: "\u9806\u624B\u518D\u8D0F\u4E0B {Value} \u5C40\u5C0F\u904A\u6232\uFF08{Progress}\uFF09"
