      m_Items:
      - rid: 3166046073766805606
  - m_Id: 2429337704849415
    m_Localized: "\u8EAB\u4E0A\u96A8\u6642\u5099\u8457 {ItemName} \xD7{Value}\uFF08{Progress}\uFF09"
