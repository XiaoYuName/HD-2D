      m_Items:
      - rid: 3166046073766805606
  - m_Id: 2429337704849414
    m_Localized: "\u53BB\u5E97\u88E1\u628A {ItemName} \u8CB7\u56DE\u4F86\uFF08{Progress}\uFF09"
