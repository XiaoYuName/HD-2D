  - m_Id: 2429337704849412
    m_Localized: "\u627E\u500B\u6A5F\u6703\u628A\u90A3\u6BB5\u8A71\u804A\u5B8C"
    m_Metadata:
      m_Items: []
  - m_Id: 2429337704849413
    m_Localized: "\u9806\u5E36\u628A\u300C{QuestName}\u300D\u4E5F\u505A\u5B8C"
