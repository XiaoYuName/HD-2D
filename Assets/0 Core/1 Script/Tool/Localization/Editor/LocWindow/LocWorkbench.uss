/* 多语言工作台样式：中性石墨灰，强调层级和输入可读性。 */

.tab-bar {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.12);
    padding: 4px 6px 0 6px;
}

.content-area,
.content-panel,
.main-split {
    flex-grow: 1;
}

.grid-search-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.tab-btn {
    border-width: 0;
    border-radius: 4px 4px 0 0;
    padding: 5px 16px;
    margin: 0 2px 0 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.6;
}

.tab-btn:hover {
    background-color: rgba(128, 128, 128, 0.18);
    opacity: 0.85;
}

.tab-btn-active {
    background-color: rgba(128, 128, 128, 0.22);
    opacity: 1;
    -unity-font-style: bold;
}

.tab-btn-active:hover {
    background-color: rgba(128, 128, 128, 0.22);
}

.side-panel {
    background-color: rgba(0, 0, 0, 0.10);
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.25);
    overflow: hidden;
}

.side-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 6px 4px 10px;
}

.section-title {
    -unity-font-style: bold;
    font-size: 12px;
    opacity: 0.75;
}

.icon-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 1px 7px;
    margin: 0;
    border-radius: 4px;
    font-size: 14px;
}

.icon-btn:hover {
    background-color: rgba(128, 128, 128, 0.25);
}

.search-field {
    margin: 2px 8px 6px 8px;
    flex-shrink: 1;
    max-width: 100%;
}

.table-search-row {
    flex-direction: row;
    align-items: center;
}

.table-search-field {
    flex-grow: 1;
    margin-right: 4px;
}

.table-add-btn {
    width: 26px;
    height: 22px;
    padding: 0;
    margin: 2px 6px 6px 0;
}

.table-list {
    flex-grow: 1;
    margin: 0 4px 4px 4px;
}

.table-item {
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    border-radius: 4px;
    -unity-text-align: middle-left;
}

.table-item-dot {
    font-size: 9px;
    margin-right: 6px;
}

.dot-on {
    color: #6DBD63;
}

.dot-off {
    color: rgba(128, 128, 128, 0.55);
}

.table-item-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.work-area {
    padding: 10px 12px 8px 12px;
    flex-grow: 1;
}

.page-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.card {
    background-color: rgba(128, 128, 128, 0.09);
    border-radius: 6px;
    border-width: 0;
    padding: 8px;
    margin-bottom: 8px;
}

.btn-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
}

.path-row {
    flex-direction: row;
    align-items: flex-end;
}

.scan-path-field {
    flex-grow: 1;
    margin-right: 6px;
}

.table-name-field {
    flex-grow: 1;
    margin-right: 6px;
}

.btn {
    border-width: 0;
    border-radius: 4px;
    padding: 4px 12px;
    margin: 2px 6px 2px 0;
    background-color: rgba(128, 128, 128, 0.18);
}

.btn:hover {
    background-color: rgba(128, 128, 128, 0.32);
}

.btn-primary {
    background-color: rgba(205, 205, 205, 0.24);
    color: #F0F0F0;
    -unity-font-style: bold;
}

.btn-primary:hover {
    background-color: rgba(225, 225, 225, 0.36);
}

.btn-danger {
    background-color: rgba(220, 90, 80, 0.20);
}

.btn-danger:hover {
    background-color: rgba(220, 90, 80, 0.38);
}

.csv-pane {
    background-color: rgba(0, 0, 0, 0.06);
    border-radius: 6px;
    margin-right: 2px;
}

.csv-list {
    flex-grow: 1;
    margin: 0 4px 4px 4px;
}

.context-menu {
    position: absolute;
    min-width: 160px;
    padding: 4px;
    border-radius: 6px;
    background-color: #4A4A4A;
}

.context-menu-item {
    min-height: 25px;
    padding: 3px 9px;
    margin: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0);
    color: #E8E8E8;
    -unity-text-align: middle-left;
}

.context-menu-item:hover {
    background-color: rgba(128, 128, 128, 0.30);
}

.context-menu-danger {
    color: #E07A73;
}

.context-menu-danger:hover {
    background-color: rgba(220, 90, 80, 0.25);
}

.context-menu-separator {
    height: 1px;
    margin: 4px 5px;
    background-color: rgba(128, 128, 128, 0.28);
}

.grid-area {
    margin-left: 8px;
    flex-grow: 1;
}

.grid-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.grid-view {
    flex-grow: 1;
    margin-top: 4px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(150, 150, 150, 0.22);
    background-color: rgba(0, 0, 0, 0.10);
    overflow: hidden;
}

.cell-field {
    height: 22px;
    margin: 1px 2px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #D8D8D8;
}

.cell-field .unity-text-input {
    padding: 1px 7px;
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(150, 150, 150, 0.32);
    background-color: rgba(24, 24, 24, 0.30);
    color: #D8D8D8;
}

.cell-field:hover .unity-text-input {
    border-color: rgba(185, 185, 185, 0.46);
    background-color: rgba(180, 180, 180, 0.08);
}

.cell-field .unity-text-input:focus {
    border-width: 1px;
    border-color: rgba(205, 205, 205, 0.72);
    background-color: rgba(180, 180, 180, 0.13);
    color: #F0F0F0;
}

.grid-view .unity-multi-column-header {
    height: 28px;
    min-height: 28px;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(150, 150, 150, 0.16);
    background-color: rgba(28, 28, 28, 0.52);
}

.grid-view .unity-multi-column-header__column {
    padding: 0;
    border-width: 0;
    border-right-width: 1px;
    border-right-color: rgba(145, 145, 145, 0.13);
    background-color: rgba(0, 0, 0, 0);
}

.grid-view .unity-multi-column-header__column-content {
    padding: 0 8px;
    align-items: center;
}

.grid-view .unity-multi-column-header__column-title {
    color: #BEBEBE;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.grid-view .unity-multi-column-header__column-resize-handle {
    width: 3px;
    background-color: rgba(0, 0, 0, 0);
}

.grid-view .unity-multi-column-header__column:hover {
    background-color: rgba(180, 180, 180, 0.07);
}

.grid-view .unity-collection-view__item {
    border-bottom-width: 1px;
    border-bottom-color: rgba(150, 150, 150, 0.09);
}

.grid-view .unity-collection-view__item:hover {
    background-color: rgba(180, 180, 180, 0.08);
}

.grid-view .unity-collection-view__item--selected {
    background-color: rgba(205, 205, 205, 0.14);
}

.placeholder {
    margin-top: 14px;
    margin-left: 10px;
    opacity: 0.55;
}

.status-bar {
    background-color: rgba(128, 128, 128, 0.09);
    border-radius: 4px;
    padding: 6px 9px;
    margin-top: 8px;
    min-height: 34px;
    white-space: normal;
}

.create-table-popup {
    position: absolute;
    width: 220px;
    padding: 8px;
    border-radius: 5px;
    background-color: #4A4A4A;
}

.dialog-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
}

.dialog-card {
    min-width: 330px;
    padding: 12px;
    border-radius: 6px;
    background-color: #4A4A4A;
}

.dialog-message {
    color: #E07A73;
    margin-top: 4px;
}
