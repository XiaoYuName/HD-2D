<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="TabBar" class="tab-bar">
        <ui:Button name="WorkbenchTabBtn" text="工作台" class="tab-btn" />
        <ui:Button name="ToolsTabBtn" text="工具" class="tab-btn" />
        <ui:Button name="SettingsTabBtn" text="设置" class="tab-btn" />
    </ui:VisualElement>
    <ui:VisualElement name="ContentArea" class="content-area">
        <ui:VisualElement name="WorkbenchContent" class="content-panel">
            <ui:TwoPaneSplitView fixed-pane-index="0" fixed-pane-initial-dimension="230" orientation="Horizontal" class="main-split">
                <ui:VisualElement class="side-panel">
                    <ui:VisualElement class="side-header">
                        <ui:Label text="字符串表" class="section-title" />
                        <ui:Button name="RefreshTablesBtn" text="⟳" tooltip="重新扫描工程内的字符串表" class="icon-btn" />
                    </ui:VisualElement>
                    <ui:VisualElement class="table-search-row">
                        <uie:ToolbarSearchField name="TableSearch" class="search-field table-search-field" />
                        <ui:Button name="CreateStringTableDialogBtn" text="＋" tooltip="新建字符串表" class="icon-btn table-add-btn" />
                    </ui:VisualElement>
                    <ui:ListView name="TableList" fixed-item-height="26" class="table-list" />
                </ui:VisualElement>
                <ui:VisualElement name="WorkArea" class="work-area">
                    <ui:Label name="TableTitle" class="page-title" />
                    <ui:VisualElement class="card">
                        <ui:VisualElement name="TableActions" class="btn-row">
                            <ui:Button name="ImportAllBtn" text="增量导入全部 CSV" class="btn" />
                            <ui:Button name="RebuildImportBtn" text="重建导入（清空表后导入）" class="btn btn-danger" />
                            <ui:Button name="AnalyzeCsvsBtn" text="检测重复 / 多余 Key" class="btn" />
                            <ui:Button name="CreateCsvBtn" text="新建 CSV" class="btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="CsvSection" class="content-panel">
                        <ui:TwoPaneSplitView fixed-pane-index="0" fixed-pane-initial-dimension="190" orientation="Horizontal" class="main-split">
                            <ui:VisualElement class="csv-pane">
                                <ui:VisualElement class="side-header">
                                    <ui:Label text="本表 CSV" class="section-title" />
                                    <ui:Button name="AddCsvBtn" text="＋" tooltip="关联一份已有 CSV 文件" class="icon-btn" />
                                    <ui:Button name="RemoveCsvBtn" text="－" tooltip="取消选中 CSV 与本表的关联（不删除文件）" class="icon-btn" />
                                </ui:VisualElement>
                                <ui:ListView name="CsvList" fixed-item-height="24" class="csv-list" />
                            </ui:VisualElement>
                            <ui:VisualElement class="grid-area">
                                <ui:VisualElement class="grid-toolbar">
                                    <uie:ToolbarSearchField name="SearchField" class="grid-search-field" />
                                    <ui:Button name="AddRowBtn" text="＋ 加行" class="btn" />
                                    <ui:Button name="DeleteRowsBtn" text="－ 删选中行" class="btn btn-danger" />
                                    <ui:Button name="ReloadCsvBtn" text="还原" class="btn" />
                                    <ui:Button name="SaveCsvBtn" text="保存 CSV" class="btn btn-primary" />
                                </ui:VisualElement>
                                <ui:Toggle name="AutoImportToggle" label="保存后自动导入本表" value="true" />
                                <ui:MultiColumnListView name="Grid" fixed-item-height="24" class="grid-view" />
                                <ui:Label name="CsvPlaceholder" text="← 在左侧选择一个 CSV" class="placeholder" />
                            </ui:VisualElement>
                        </ui:TwoPaneSplitView>
                    </ui:VisualElement>
                    <ui:Label name="Status" class="status-bar" />
                </ui:VisualElement>
            </ui:TwoPaneSplitView>
        </ui:VisualElement>
        <ui:VisualElement name="ToolsContent" class="content-panel">
            <ui:VisualElement class="work-area">
                <ui:Label text="工具" class="page-title" />
                <ui:VisualElement class="card">
                    <ui:Label text="扫描工程内全部 String 表集合，给含 {占位符} 的文案自动勾选 Smart String。" />
                    <ui:VisualElement class="btn-row">
                        <ui:Button name="AutoMarkSmartBtn" text="给所有 String 表集合自动标记 Smart String" class="btn" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="card">
                    <ui:Label text="清理所有 String 表中已不属于 Shared Data 的 Smart Format ID，不影响有效的 Smart String 标记。" />
                    <ui:VisualElement class="btn-row">
                        <ui:Button name="CleanSmartFormatBtn" text="清理无效 Smart Format ID" class="btn btn-danger" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="ToolsStatus" class="status-bar" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsContent" class="content-panel">
            <ui:VisualElement class="work-area">
                <ui:Label text="设置" class="page-title" />
                <ui:VisualElement class="card">
                    <ui:Label text="字符串表扫描路径（包含所有子目录）。路径与扫描结果缓存均保存到本目录的 LocWorkbenchConfig.asset。" />
                    <ui:VisualElement class="path-row">
                        <ui:TextField name="ScanPathField" label="扫描路径" is-delayed="true" class="scan-path-field" />
                        <ui:Button name="SelectScanPathBtn" text="选择目录" class="btn" />
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-row">
                        <ui:Button name="SaveScanPathBtn" text="保存并重新扫描" class="btn btn-primary" />
                        <ui:Button name="RefreshSettingsBtn" text="重新扫描" class="btn" />
                    </ui:VisualElement>
                    <ui:Label name="TableCacheLabel" />
                </ui:VisualElement>
                <ui:VisualElement class="card">
                    <ui:Label text="新建字符串表会使用项目当前已配置的 Locale，并创建在扫描目录下以表名命名的子目录中。" />
                    <ui:VisualElement class="path-row">
                        <ui:TextField name="NewTableNameField" label="表名" is-delayed="true" class="table-name-field" />
                        <ui:Button name="CreateStringTableBtn" text="新建字符串表" class="btn btn-primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="ScanStatus" class="status-bar" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
