.texture-tools-root {
    color: rgb(235, 235, 240);
    background-color: rgb(41, 41, 45);
}

.texture-tools-root .texture-tools-button {
    height: 28px;
    margin-right: 8px;
}

.texture-tools-root .texture-tools-card {
    background-color: rgb(52, 52, 56);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.texture-tools-root .texture-tools-muted {
    color: rgba(255, 255, 255, 0.5);
}

.texture-tools-root .texture-tools-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.texture-tools-root .texture-tools-preview {
    background-size: contain;
}
