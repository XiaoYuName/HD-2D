<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="embroidery-workbench">
        <ui:VisualElement name="toolbar-slot" class="workbench-toolbar" />
        <ui:VisualElement class="workbench-body">
            <ui:VisualElement name="level-slot" class="workbench-sidebar workbench-levels" />
            <ui:VisualElement class="workbench-canvas-pane">
                <ui:Label name="canvas-title" text="未选择关卡" class="section-title canvas-title" />
                <ui:VisualElement name="canvas-host" class="canvas-host" />
                <ui:VisualElement class="canvas-hint-row">
                    <ui:Label name="canvas-hint"
                              text="拖动线或控制点；Shift+点击追加点；拖动数字；Ctrl+C / Ctrl+V 复制粘贴线；Ctrl+Z / Ctrl+Y 撤销重做"
                              class="canvas-hint" />
                    <ui:Button name="clear-hint" text="×" tooltip="隐藏操作提示" class="hint-close" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="workbench-inspector">
                <ui:VisualElement class="inspector-tabs">
                    <ui:Button name="level-tab" text="关卡与线网" class="inspector-tab inspector-tab--active" />
                    <ui:Button name="region-tab" text="单元属性" class="inspector-tab" />
                </ui:VisualElement>
                <ui:ScrollView name="level-inspector" class="inspector-scroll" />
                <ui:ScrollView name="region-inspector" class="inspector-scroll hidden" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="status-area" class="status-area hidden">
            <ui:VisualElement name="status-content" class="status-content" />
            <ui:Button name="clear-status" text="×" tooltip="清除提示" class="status-close" />
        </ui:VisualElement>
        <ui:VisualElement name="validation-area" class="status-area hidden">
            <ui:VisualElement name="validation-content" class="status-content" />
            <ui:Button name="clear-validation" text="×" tooltip="清除校验信息" class="status-close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
