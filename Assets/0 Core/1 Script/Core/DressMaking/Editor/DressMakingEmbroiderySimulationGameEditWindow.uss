.embroidery-workbench {
    flex-grow: 1;
    padding: 8px;
    background-color: rgb(40, 42, 46);
}

.workbench-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 34px;
    margin-bottom: 7px;
    padding: 3px 6px;
    background-color: rgb(50, 53, 58);
    border-radius: 4px;
}

.workbench-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.workbench-sidebar {
    flex-shrink: 0;
    width: 220px;
    min-width: 190px;
    margin-right: 7px;
    padding: 7px;
    background-color: rgb(48, 51, 56);
    border-radius: 4px;
}

.workbench-canvas-pane {
    flex-grow: 1;
    min-width: 360px;
    min-height: 0;
    margin-right: 7px;
    padding: 7px;
    background-color: rgb(45, 48, 52);
    border-radius: 4px;
}

.section-title {
    flex-shrink: 0;
    height: 24px;
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(225, 230, 234);
}

.canvas-host {
    flex-grow: 1;
    min-height: 260px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(31, 34, 38);
    border-width: 1px;
    border-color: rgb(72, 77, 84);
}

.canvas-hint-row {
    flex-shrink: 0;
    height: 28px;
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
    padding-left: 6px;
    padding-right: 6px;
    justify-content: center;
    background-color: rgb(52, 55, 60);
    border-radius: 3px;
}

.canvas-hint {
    flex-grow: 1;
    min-width: 0;
    -unity-text-align: middle-left;
    color: rgb(174, 184, 193);
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
}

.hint-close {
    flex-shrink: 0;
    width: 24px;
    height: 22px;
    margin-left: 4px;
    padding: 0;
    font-size: 14px;
}

.workbench-inspector {
    flex-shrink: 0;
    width: 370px;
    min-width: 330px;
    min-height: 0;
    padding: 7px;
    background-color: rgb(48, 51, 56);
    border-radius: 4px;
}

.inspector-tabs {
    flex-direction: row;
    flex-shrink: 0;
    height: 30px;
    margin-bottom: 5px;
}

.inspector-tab {
    flex-grow: 1;
    height: 28px;
    margin: 0 2px;
    background-color: rgb(57, 60, 65);
}

.inspector-tab--active {
    background-color: rgb(62, 104, 130);
    color: white;
}

.inspector-scroll {
    flex-grow: 1;
    min-height: 0;
}

.inspector-scroll > .unity-scroll-view__content-container {
    padding-right: 5px;
}

.inspector-scroll .unity-base-field {
    margin-top: 2px;
    margin-bottom: 2px;
}

.inspector-scroll .unity-base-field__label {
    min-width: 120px;
}

.inspector-section {
    flex-shrink: 0;
    margin-top: 5px;
    margin-bottom: 6px;
    padding: 7px;
    background-color: rgb(55, 58, 63);
    border-radius: 4px;
}

.inspector-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
    margin-bottom: 5px;
}

.inspector-actions > Button {
    min-height: 24px;
    margin: 2px;
}

.status-area {
    flex-shrink: 0;
    max-height: 58px;
    min-height: 30px;
    margin-top: 5px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(46, 49, 53);
    border-radius: 4px;
}

.status-content {
    flex-grow: 1;
    min-width: 0;
}

.status-content .unity-help-box {
    margin: 0;
    max-height: 54px;
}

.status-close {
    flex-shrink: 0;
    width: 28px;
    height: 25px;
    margin-right: 4px;
    font-size: 16px;
    -unity-font-style: bold;
}

.hidden {
    display: none;
}
