[
  {
    "name": "search_code",
    "description": "Grouped search. Blocks include exact hit offsets and a stable matchId reusable by read_code.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "mode": { "type": "string", "enum": ["literal", "regex"], "default": "literal" },
        "paths": { "type": "array", "items": { "type": "string", "description": "Project-relative path (Assets/... or Packages/...) or an absolute path inside the project. Outputs always use project-relative forward-slash paths." } },
        "includeGlobs": { "type": "array", "items": { "type": "string" } },
        "excludeGlobs": { "type": "array", "items": { "type": "string" } },
        "caseSensitive": { "type": "boolean" },
        "wholeWord": { "type": "boolean", "default": false },
        "contextLines": { "type": "integer", "minimum": 0, "maximum": 10, "default": 0 },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
        "maxChars": { "type": "integer", "minimum": 1000, "maximum": 100000, "default": 12000 }
      },
      "required": ["pattern"],
      "additionalProperties": false
    }
  },
  {
    "name": "read_code",
    "description": "Reads a bounded range or search match, returns SHA-256, and optionally emits explicit [line,text] pairs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "Project-relative path (Assets/... or Packages/...) or an absolute path inside the project. Output is always project-relative." },
        "matchId": { "type": "string", "description": "Opaque id returned by search_code; mutually exclusive with path." },
        "startLine": { "type": "integer", "minimum": 1, "default": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "maxChars": { "type": "integer", "minimum": 1000, "maximum": 100000, "default": 20000 },
        "includeLineNumbers": { "type": "boolean", "default": false },
        "compact": { "type": "boolean", "default": false, "description": "Return [line,text] pairs and omit duplicate content plus encoding/EOL metadata. Prefer for multiple reads." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "find_symbol",
    "description": "Roslyn C# declarations and optional exact references, with explicit syntax fallback.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Exact name for initial lookup." },
        "symbolId": { "type": "string", "description": "Returned id for disambiguated lookup." },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["class", "struct", "interface", "enum", "record", "delegate", "method", "constructor", "property", "field", "event"]
          }
        },
        "includeReferences": { "type": "boolean", "default": false },
        "paths": { "type": "array", "items": { "type": "string", "description": "Project-relative path (Assets/... or Packages/...) or an absolute path inside the project. Outputs always use project-relative forward-slash paths." } },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },
        "maxChars": { "type": "integer", "minimum": 1000, "maximum": 100000, "default": 12000 }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "replace_symbol",
    "description": "Replaces one Roslyn symbol declaration or body by stable symbolId, with SHA and syntax validation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "symbolId": { "type": "string" },
        "expectedSha256": { "type": "string" },
        "mode": { "type": "string", "enum": ["declaration", "body"], "default": "declaration" },
        "newText": { "type": "string" },
        "dryRun": { "type": "boolean", "default": false }
      },
      "required": ["symbolId", "expectedSha256", "newText"],
      "additionalProperties": false
    }
  },
  {
    "name": "apply_patch",
    "description": "Atomic multi-file line or anchored-text edits with dry-run, optional rebase, SHA checks, and C# syntax validation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "description": "Project-relative path (Assets/... or Packages/...) or an absolute path inside the project. Output is always project-relative." },
              "expectedSha256": { "type": "string", "description": "Required for existing files." },
              "create": { "type": "boolean", "default": false },
              "allowRebase": { "type": "boolean", "default": false, "description": "On hash mismatch, reapply unique text replacements to current content." },
              "edits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "startLine": { "type": "integer", "minimum": 1 },
                    "deleteLineCount": { "type": "integer", "minimum": 0, "default": 0 },
                    "newText": { "type": "string", "description": "Logical replacement lines." },
                    "expectedOldText": { "type": "string", "description": "Optional exact anchor for the deleted line range." }
                  },
                  "required": ["startLine", "newText"],
                  "additionalProperties": false
                }
              },
              "replacements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "oldText": { "type": "string" },
                    "newText": { "type": "string" },
                    "replaceAll": { "type": "boolean", "default": false },
                    "matchMode": { "type": "string", "enum": ["exact", "trimmedLines"], "default": "exact", "description": "trimmedLines matches a unique whole-line sequence while ignoring indentation and trailing whitespace." }
                  },
                  "required": ["oldText", "newText"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        },
        "dryRun": { "type": "boolean", "default": false },
        "validateSyntax": { "type": "boolean", "default": true }
      },
      "required": ["files"],
      "additionalProperties": false
    }
  },
  {
    "name": "inspect_unity_code",
    "description": "Inspects Unity serialized fields, FormerlySerializedAs coverage, script GUID references, and asset importer metadata.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "Project-relative path (Assets/... or Packages/...) or an absolute path inside the project. Output is always project-relative." },
        "fieldName": { "type": "string" },
        "includeAssetReferences": { "type": "boolean", "default": true },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 }
      },
      "required": ["path"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_diagnostics",
    "description": "Reads grouped UnityCompileMcp diagnostics and reports staleness without compiling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "severity": { "type": "string", "enum": ["error", "warning", "all"], "default": "error" },
        "paths": { "type": "array", "items": { "type": "string", "description": "Project-relative path (Assets/... or Packages/...) or an absolute path inside the project. Outputs always use project-relative forward-slash paths." } },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
        "maxChars": { "type": "integer", "minimum": 1000, "maximum": 100000, "default": 12000 }
      },
      "additionalProperties": false
    }
  }
]
